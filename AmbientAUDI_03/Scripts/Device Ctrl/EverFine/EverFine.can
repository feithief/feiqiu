/*@!Encoding:936*/
includes
{

}

variables
{
  const int SMDataLength = 256;
  word SMgcnt=0;
  const word SMCOMPort = 2;
  const byte TimeStampLength = 32;
  const byte DataLength = 16;
  const byte EverFineMeasTimeout = 6;
  const long MAXIP = 50000;//58900;
  const long MINIP = (MAXIP/2-2000);
  
  
  struct SxyL
  {
    word x;
    word y;
    dword L;
    dword IP;
  };
  struct SEverFine
  {
    byte Cmd;byte Resp;
    byte CmdData[DataLength];
    byte RespData[DataLength];
    struct SxyL CIExyL;
    char TimeStamp[TimeStampLength];
  }EverFineData;
  enum ECmd
  {
    NoCmd_0 = 0,
    GetInitInfo_1,
    ReInit_2,
    GetCIExyL_3,
    TempCtrlOn_4,
    TempCtrlOFF_5,
    GetCurrentTemp_6,
    SetCurrentTemp_7,
    GetCIExyLwithIdealIP_8,
    GetAverageCIExyL_9,
    ///////////////////////////////////////
    Delima_1,
    TextOutput_OFF,
    TextOutput_ON,
    CloseEverFine_20
  };
  
  struct SEverFineCtrl
  {
    char ScriptPath[SMDataLength];
    char ExePath[SMDataLength];
    byte SMData[SMDataLength];
    int64 TimeStart;
    int64 TimeElapsed;
  }EverFineCtrl;
  
  enum EReturnType
  {
    GetDataWithGoodInteralTime = 0,
    UndefinedResult,
    Timeout_AllZeros,
    Timeout_InteralTimeUnavailable
  };
}

void HAAS1200_CtrlInit(void)
{
  char exePath[SMDataLength];
  long ret = 0;
  getAbsFilePath("Scripts", EverFineCtrl.ScriptPath,SMDataLength);
  snprintf(EverFineCtrl.ExePath, SMDataLength, "%s\\Device Ctrl\\EverFine\\", EverFineCtrl.ScriptPath);
  snprintf(exePath, SMDataLength, "%s\\HAASDriver_ShareMemo.exe", EverFineCtrl.ExePath);
  ret = sysExec(exePath,"", EverFineCtrl.ExePath);
  @sysvar::DeviceCtrl::EverFine::AverageTime = 4;
}

void HAAS1200_Execute(word mode)
{
  local_ClearBuffer();
  switch(mode)
  {
    case GetInitInfo_1:  // Init success judgement
      EverFineData.Cmd = GetInitInfo_1;
      memcpy(EverFineCtrl.SMData, EverFineData);
      HAAS1200_SetGeneralCmd_LJM(EverFineCtrl.SMData);  
      local_JudgeTimeout("<HAAS1200Ctrl()> GetInitInfo_1", 5);
      if(EverFineData.RespData[0] == 2)
      {
        //write(" HAAS1200 Init success.");
        WriteLineLJM(e_sink_SystemPage,e_severity_Success, "HAAS1200 Init success.");
      }
      else
      {
        //write(" HAAS1200 Init failure.");
        WriteLineLJM(e_sink_SystemPage,e_severity_Error, "HAAS1200 Init failure.");
      }
      break;     
    case ReInit_2:
      EverFineData.Cmd = ReInit_2;
      memcpy(EverFineCtrl.SMData, EverFineData);
      HAAS1200_SetGeneralCmd_LJM(EverFineCtrl.SMData); 
      break;
    case GetCIExyL_3:
      EverFineCtrl.TimeStart = timeNowInt64();
      Public_GetxyL(TextOutput_OFF);
      EverFineCtrl.TimeElapsed = timeNowInt64()-EverFineCtrl.TimeStart;
      snprintf(OutString, MAXFilePathLength, "<HAAS1200_Execute(GetCIExyL_3)> %.2fs is required to get Opt Value.", 
        (float)(EverFineCtrl.TimeElapsed)/1000000000);
      WriteLineLJM(e_sink_SystemPage,e_severity_Information, OutString);
      break;     
    case TempCtrlOn_4: // Start Temperature ctrl
      EverFineData.Cmd = TempCtrlOn_4;
      EverFineData.CmdData[0] = SMCOMPort; /* [0] represents COM port. it is 2 in E301, shanghai keboda */
      memcpy(EverFineCtrl.SMData, EverFineData);
      HAAS1200_SetGeneralCmd_LJM(EverFineCtrl.SMData);
      break;
    case TempCtrlOFF_5: // Stop Temperature ctrl
      EverFineData.Cmd = TempCtrlOFF_5;
      EverFineData.CmdData[0] = SMCOMPort; /* [0] represents COM port. it is 2 in E301, shanghai keboda */
      memcpy(EverFineCtrl.SMData, EverFineData);
      HAAS1200_SetGeneralCmd_LJM(EverFineCtrl.SMData);
      break;
    case GetCurrentTemp_6:  // Get temperature   
      EverFineData.Cmd = GetCurrentTemp_6;
      memcpy(EverFineCtrl.SMData, EverFineData);
      HAAS1200_SetGeneralCmd_LJM(EverFineCtrl.SMData);     
      local_JudgeTimeout("<HAAS1200Ctrl()> GetCurrentTemp_6", 5);
      SMgcnt = (word)((word)EverFineData.RespData[0] | ((word)EverFineData.RespData[1]<<8));
      @DeviceCtrl::EverFine::GetTemperature_env = (int)(SMgcnt/100);
      SMgcnt = (word)((word)EverFineData.RespData[2] | ((word)EverFineData.RespData[3]<<8));
      @DeviceCtrl::EverFine::GetTemperature_cur = (int)(SMgcnt/100); 
      break;
    case SetCurrentTemp_7:  // set temperature
      EverFineData.Cmd = SetCurrentTemp_7;
      SMgcnt = (word)((int)(@sysvar::DeviceCtrl::EverFine::SetTemperature) * (int)100);
      EverFineData.CmdData[0] = (byte)(SMgcnt&0x00ff);
      EverFineData.CmdData[1] = (byte)((SMgcnt&0xff00)>>8);
      memcpy(EverFineCtrl.SMData, EverFineData);
      HAAS1200_SetGeneralCmd_LJM(EverFineCtrl.SMData);
      break; 
    case GetCIExyLwithIdealIP_8:
      Public_GetIdealCIEData("");
      break;
    case GetAverageCIExyL_9:
      //deleted
      break;
    case CloseEverFine_20: // delete shared memory
      EverFineData.Cmd = CloseEverFine_20;
      memcpy(EverFineCtrl.SMData, EverFineData);
      HAAS1200_SetGeneralCmd_LJM(EverFineCtrl.SMData);
      break;
  }
}

void local_ClearBuffer(void)
{ 
  for(SMgcnt = 0; SMgcnt<SMDataLength; SMgcnt++)
  {
    EverFineCtrl.SMData[SMgcnt]=0;
  }
  memcpy(EverFineData, EverFineCtrl.SMData); 
}


void local_GetSharedMemory(void)
{
  HAAS1200_GetSharedMemory_LJM(EverFineCtrl.SMData);
/*
  write("EverFineCtrl.SMData  byte[]");
  for(SMgcnt = 0; SMgcnt<60; SMgcnt += 6)
  {
    write("%x,  %x,  %x,  %x,  %x,  %x,", EverFineCtrl.SMData[SMgcnt], EverFineCtrl.SMData[SMgcnt+1], EverFineCtrl.SMData[SMgcnt+2], 
      EverFineCtrl.SMData[SMgcnt+3], EverFineCtrl.SMData[SMgcnt+4], EverFineCtrl.SMData[SMgcnt+5]);
  }
*/ 
  memcpy(EverFineData, EverFineCtrl.SMData);
  /*
  write("Cmd = %d, Resp = %d",EverFineData.Cmd, EverFineData.Resp);
  write("x=%d, y=%d, L=%d, IP = %d", EverFineData.CIExyL.x, EverFineData.CIExyL.y, EverFineData.CIExyL.L, EverFineData.CIExyL.IP);
  write("log time = %s", EverFineData.TimeStamp);
  */
}

void local_JudgeTimeout(char funName[], word Timeout_s)
{
  word TimeoutCNT = 0;
  TimeoutCNT = 0;
  while(1)
  {
    testWaitForTimeout(1000);
    local_GetSharedMemory();
    if(EverFineData.Resp != 0)
    {
      break;
    }
    else
    {
      if(TimeoutCNT++>Timeout_s)
      {
        //write("<%s> Time out(%ds has elapsed)!", funName, Timeout_s);
        snprintf(OutString, MAXFilePathLength, "<local_JudgeTimeout::%s> Time out(%ds has elapsed)!", funName, Timeout_s);
        WriteLineLJM(e_sink_SystemPage,e_severity_Error, OutString);
        break;
      }
    }
  }
}


void Public_GetxyL(word TextOutputEnable)
{
  local_ClearBuffer();
  EverFineData.Cmd = GetCIExyL_3;
  SMgcnt = @DeviceCtrl::EverFine::IntegralTime;
  EverFineData.CmdData[0] = (byte)(SMgcnt & 0x00ff);
  EverFineData.CmdData[1] = (byte)((SMgcnt & 0xff00)>>8);
  SMgcnt = @DeviceCtrl::EverFine::AverageTime;
  EverFineData.CmdData[2] = (byte)(SMgcnt & 0x00ff);
  EverFineData.CmdData[3] = (byte)((SMgcnt & 0xff00)>>8);     
  memcpy(EverFineCtrl.SMData, EverFineData);
  HAAS1200_SetGeneralCmd_LJM(EverFineCtrl.SMData);   
  local_JudgeTimeout("<Public_GetxyL()> timeout set = 300s.", 300); 
  if (TextOutputEnable == TextOutput_ON)
  {
    snprintf(OutString, MAXFilePathLength, "Cmd R,G,B,L = [%d, %d, %d, %d], Opt measure values x,y,L,IP = [%d, %d, %d, %d]", (word)getSignal(BCM_RGBa_Rot), 
      (word)getSignal(BCM_RGBa_Gruen), (word)getSignal(BCM_RGBa_Blau), (word)getSignal(BCM_RGBa_Intensitaet),
      EverFineData.CIExyL.x, EverFineData.CIExyL.y, EverFineData.CIExyL.L, EverFineData.CIExyL.IP);
    WriteLineLJM(e_sink_CAPLPage,e_severity_Information, OutString);
  }
  //WriteLineLJM(e_sink_SystemPage,e_severity_Information, OutString);
  @sysvar::DeviceCtrl::EverFine::CIEx = EverFineData.CIExyL.x;
  @sysvar::DeviceCtrl::EverFine::CIEy = EverFineData.CIExyL.y;
  @sysvar::DeviceCtrl::EverFine::CIEL = EverFineData.CIExyL.L;
  @sysvar::DeviceCtrl::EverFine::IP = EverFineData.CIExyL.IP;
}

