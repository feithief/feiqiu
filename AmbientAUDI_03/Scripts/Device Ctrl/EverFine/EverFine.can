/* 无所谓输出的in_CmdText填"" */
word Public_GetIdealCIEData(char in_CmdText[])
{
  word TimeoutCNT = 0, ret_GetRealData;
  
  TimeoutCNT = 0;  
  ret_GetRealData = UndefinedResult;
  EverFineCtrl.TimeStart = timeNowInt64();
  testWaitForTimeout(200);
  do
  {        
    Public_GetxyL(TextOutput_OFF);  //普通采集函数不输出
    if((EverFineData.CIExyL.x == 0) || (EverFineData.CIExyL.y == 0) || (EverFineData.CIExyL.L == 0))
    {
      write("<EverFine.can::Public_GetIdealCIEData()> [x,y,L] = 0", EverFineData.CIExyL.x, EverFineData.CIExyL.y, EverFineData.CIExyL.L);
      TimeoutCNT++;
      if(TimeoutCNT > EverFineMeasTimeout)
      {
        ret_GetRealData = Timeout_AllZeros;
        break;  //在原来的函数中，这里是return
      }
      testWaitForTimeout(2000);
      continue;
    }  // 异常值判断
    //write("TimeoutCNT=%d, IP=%d, (%d,%d)", TimeoutCNT, @DeviceCtrl::EverFine::IP, MINIP, MAXIP);
    if( (EverFineData.CIExyL.IP >= MINIP) && (EverFineData.CIExyL.IP <= MAXIP))
    {  //合适的IP
      ret_GetRealData = GetDataWithGoodInteralTime;
      break;
    }
    else if (EverFineData.CIExyL.IP > MAXIP)  
    {
      @DeviceCtrl::EverFine::IntegralTime = @DeviceCtrl::EverFine::IntegralTime>>3;
      @DeviceCtrl::EverFine::IntegralTime = @DeviceCtrl::EverFine::IntegralTime*4;
      testWaitForTimeout(1000);
      continue;
    }
    else  //IP值过小
    {
      if(TimeoutCNT++> EverFineMeasTimeout)
      {
        ret_GetRealData = Timeout_InteralTimeUnavailable;
        break;  //在原来的函数中，这里是return
      }
      else  // 未超时
      {
        if(EverFineData.CIExyL.IP == 0)
        {
          testWaitForTimeout(1000);
          continue;
        }
        if ((EverFineData.CIExyL.L <= 2000) && (EverFineData.CIExyL.IP > 8000))
        {  //亮度过小 且Ip不算太小就让它去吧
          ret_GetRealData = GetDataWithGoodInteralTime;
          break;
        }
        if ((EverFineData.CIExyL.L < 4000)    //这是亮度非常低(0.4lm)的情况，API会显示正确的值但是IP永远不会再高了
            && (EverFineData.CIExyL.x != 0)
            && (EverFineData.CIExyL.y != 0)
            &&  TimeoutCNT >= 3)
        {
          @DeviceCtrl::EverFine::IntegralTime = 2000;
          ret_GetRealData = GetDataWithGoodInteralTime;
          break;
        }
        
        // 计算 积分时间, break的不会到这里
        @DeviceCtrl::EverFine::IntegralTime = EverFineLocal_GetIntegrate(
          (dword)@DeviceCtrl::EverFine::IntegralTime, (dword)EverFineData.CIExyL.IP, (dword)MAXIP);
        snprintf(OutString, MAXFilePathLength, "<Public_GetIdealCIEData()> New Integrated time = %ld. Have retried %d times.", 
          (dword)@DeviceCtrl::EverFine::IntegralTime, TimeoutCNT);
        WriteLineLJM(e_sink_SystemPage,e_severity_Information, OutString);
        testWaitForTimeout(1000);
      }  // 计算IP的时间未超时
    }  // IP值过小
  }while(TimeoutCNT < EverFineMeasTimeout); 

  EverFineCtrl.TimeElapsed = timeNowInt64()-EverFineCtrl.TimeStart;
  testWaitForTimeout(200);
  switch(ret_GetRealData)
  {
    case GetDataWithGoodInteralTime:
      /* 在此处，in_CmdText[]应该包含 Cmd R,G,B,L = [%d, %d, %d, %d] 或 PWM R\G\B = %d. 注意in_CmdText[]要包含逗号 */
      snprintf(OutString, MAXFilePathLength,
        "%sOpt values x,y,L,IP = [%d, %d, %d, %d], %d times tried to get the suitable IntegralTime(%d), total time = %.2fs.",
        in_CmdText, EverFineData.CIExyL.x, EverFineData.CIExyL.y, EverFineData.CIExyL.L, EverFineData.CIExyL.IP, TimeoutCNT, 
        @DeviceCtrl::EverFine::IntegralTime,(float)(EverFineCtrl.TimeElapsed)/1000000000);
      WriteLineLJM(e_sink_SystemPage,e_severity_Information, OutString);
      break;
    case UndefinedResult:
    default:
      snprintf(OutString, MAXFilePathLength, 
        "<Public_GetIdealCIEData()> Comes to undefined action at %.2f, Cmd info is: %s", (float)timeNowInt64()/1000000000, in_CmdText);
      WriteLineLJM(e_sink_SystemPage,e_severity_Error, OutString);
      break;
    case Timeout_AllZeros:
      snprintf(OutString, MAXFilePathLength, "<EverFine.can::Public_GetIdealCIEData():> All zero data. Have retried %d times!", TimeoutCNT);
      WriteLineLJM(e_sink_SystemPage,e_severity_Error, OutString);
      break;
    case Timeout_InteralTimeUnavailable:
      snprintf(OutString, MAXFilePathLength, "<Public_GetIdealCIEData()>Failed to find suitable integral time! Have retried %d times", TimeoutCNT);
      WriteLineLJM(e_sink_SystemPage,e_severity_Error, OutString);
      break;
  }
  
//  switch(OutputMode)
//  {
//    case 1:  // App测试
//      snprintf(OutString, MAXFilePathLength, 
//        "Cmd R,G,B,L = [%d, %d, %d, %d], Opt values x,y,L,IP = [%d, %d, %d, %d], %d times measured to get the suitable IntegralTime(%d), total time = %.2fs.", 
//        (word)getSignal(BCM_RGBa_Rot), (word)getSignal(BCM_RGBa_Gruen), (word)getSignal(BCM_RGBa_Blau), (word)getSignal(BCM_RGBa_Intensitaet),
//        EverFineData.CIExyL.x, EverFineData.CIExyL.y, EverFineData.CIExyL.L, EverFineData.CIExyL.IP, TimeoutCNT, @DeviceCtrl::EverFine::IntegralTime,
//        (float)(EverFineCtrl.TimeElapsed)/1000000000);
//      WriteLineLJM(e_sink_SystemPage,e_severity_Information, OutString);
//      break;
//    case 2:  // LED测试
//      snprintf(OutString, MAXFilePathLength,
//        "<LED Measure> Opt values x,y,L,IP = [%d, %d, %d, %d], %d times measured to get the suitable IntegralTime(%d), total time = %.2fs.",         
//        EverFineData.CIExyL.x, EverFineData.CIExyL.y, EverFineData.CIExyL.L, EverFineData.CIExyL.IP, TimeoutCNT, @DeviceCtrl::EverFine::IntegralTime,
//        (float)(EverFineCtrl.TimeElapsed)/1000000000);
//      WriteLineLJM(e_sink_SystemPage,e_severity_Information, OutString);
//      break;
//  }
  testWaitForTimeout(200);
  return ret_GetRealData;
}



/* if int%4!=0, output=0 */
long EverFineLocal_GetIntegrate(dword NowInt, dword NowIP, dword MAXIP) 
{
  float tmpInt = 0;
  long tmp;
  tmpInt = (float)NowInt * MAXIP / (float)NowIP;
  tmp = (long)(tmpInt/4);
  if(tmpInt<=5)
  {
    tmpInt = 200;
  }
  else if (tmpInt > 30000)
  {
    tmpInt = 10000;
  }
  return (tmp*4); 
}



void HAAS1200_StopAutoMeasure(void)
{
  word TimeoutCNT = 0;
  int val = 0;
  
  TimeoutCNT = 0;
  @sysvar::DeviceCtrl::EverFine::SetTemperature = @sysvar::DeviceCtrl::EverFine::GetTemperature_env;
  HAAS1200_Execute(SetCurrentTemp_7);
  
  do
  {
    TimeoutCNT +=1;
    testWaitForTimeout(3000);
    HAAS1200_Execute(GetCurrentTemp_6);
    testWaitForTimeout(2000);
    val = abs(@sysvar::DeviceCtrl::EverFine::GetTemperature_env - @sysvar::DeviceCtrl::EverFine::SetTemperature);
    if(val <= 2)
    {
      break;
    }
    if(TimeoutCNT > 100)
    {
      break;
    }
  }while(1);
  
  // TURN OFF temp ctrl
  HAAS1200_Execute(5);
}