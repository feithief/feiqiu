void Diag_0x22Process(void)
{
  //write("<Diag_0x22Process> SSID = %x", DiagCtrl.SSID);
  switch(DiagCtrl.SSID)
  {
    case SSID_0002_LEDSupplier:
      // TODO  加否定相应不断，否定相应不进这里或不做处理
      Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[1])<<8) | (word)DiagCtrl.RespBuf[0];     
      //write("%x %x %x %x %x", DiagCtrl.RespBuf[0], DiagCtrl.RespBuf[1], DiagCtrl.RespBuf[2], DiagCtrl.RespBuf[3], DiagCtrl.RespBuf[4]); 
      if((Diag0x22_gWORD & 0x0080) > 0)
      {
        @sysvar::NodeInfo::LockState = Lock;
      }
      else
      {
        @sysvar::NodeInfo::LockState = Unlock;
      }
      break;
    case SSID_0003_SingleAddress:
      Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[1])<<8) | (word)DiagCtrl.RespBuf[0];
      if((Diag0x22_gWORD%0x0F != @sysvarMember::NodeInfo::Node.NAD))
      {
        WriteLineLJM(e_sink_SystemPage,e_severity_Error, "<Diag_0x22.can::Diag_0x22Process> NAD not correct!!");
      }
      break;
    case SSID_0004_GroupAddress:
      Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[1])<<8) | (word)DiagCtrl.RespBuf[0];
      @sysvarMember::NodeInfo::Node.GroupAddr = Diag0x22_gWORD;
      break;
    case SSID_0005_Platform:
      Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[1])<<8) | (word)DiagCtrl.RespBuf[0];
      @sysvarMember::NodeInfo::Node.Platform = Diag0x22_gWORD;
      break;
    case SSID_0006_Factor:
      Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[1])<<8) | (word)DiagCtrl.RespBuf[0];
      @sysvarMember::NodeInfo::Node.LFactor = Diag0x22_gWORD;
      break;
    case SSID_0007_Redx:   
      local_ProcessRed();
      break;
    case SSID_0008_Greenx:
      local_ProcessGreen();
      break;
    case SSID_0009_Bluex:
      local_ProcessBlue();
      break;
    case SSID_6269_Partnumber:
      local_ProcessPartNo();
      break;
    case SSID_6A69_SerialNum:
      local_ProcessSerialNo();
      break;
    case SSID_6469_SWVersion:
      local_ProcessSWVersion();
      break;
    case SSID_6869_HWVersion:
      local_ProcessHWVersion();
      break;
    case SSID_0017_LED:
      local_ProcessLED();
      break;
    case SSID_0100_OptMode:
      local_ProcessOptMode();
      break;
    case SSID_0101_Threshold:
      local_GetThresholdVals();
      break;
    case SSID_000C_Flag:
      // TODO  加否定相应不断，否定相应不进这里或不做处理
      Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[1])<<8) | (word)DiagCtrl.RespBuf[0];     
      write("<22 process case 000C>%x %x %x %x %x", DiagCtrl.RespBuf[0], DiagCtrl.RespBuf[1], DiagCtrl.RespBuf[2], DiagCtrl.RespBuf[3], DiagCtrl.RespBuf[4]); 
      if((Diag0x22_gWORD & 0x0080) > 0)
      {
        @sysvar::NodeInfo::LockState = Lock;
      }
      else
      {
        @sysvar::NodeInfo::LockState = Unlock;
      }
      @NodeInfo::Node.CtrlFlag = Diag0x22_gWORD;
      break;
  }
  
}


void local_ProcessLED(void)
{
  LEDPara_word.Redx = (word)DiagCtrl.RespBuf[1]<<8 | (word)DiagCtrl.RespBuf[0];  //0，1
  LEDPara_double.Redx = (float)LEDPara_word.Redx/10000;
  snprintf(LEDPara_string.Redx,LEDParaStringLength,"%7.6f",LEDPara_double.Redx);
  sysSetVariableString(sysvarMember::NodeInfo::Node.LED.Redx, LEDPara_string.Redx);  
  LEDPara_word.Redy = (word)DiagCtrl.RespBuf[3]<<8 | (word)DiagCtrl.RespBuf[2];  //2，3
  LEDPara_double.Redy = (float)LEDPara_word.Redy/10000;
  snprintf(LEDPara_string.Redy,LEDParaStringLength,"%7.6f",LEDPara_double.Redy);
  sysSetVariableString(sysvarMember::NodeInfo::Node.LED.Redy,LEDPara_string.Redy);  
  LEDPara_word.RedL = (dword)DiagCtrl.RespBuf[7]<<24 | (dword)DiagCtrl.RespBuf[6]<<16 |
    (dword)DiagCtrl.RespBuf[5]<<8 | (dword)DiagCtrl.RespBuf[4];//4,5,6,7 
  LEDPara_double.RedL = (float)LEDPara_word.RedL/10000;
  snprintf(LEDPara_string.RedL, LEDParaStringLength,"%7.6f",LEDPara_double.RedL);
  sysSetVariableString(sysvarMember::NodeInfo::Node.LED.RedL,LEDPara_string.RedL);
  
  LEDPara_word.Greenx = (word)DiagCtrl.RespBuf[9]<<8 | (word)DiagCtrl.RespBuf[8];  //8，9
  LEDPara_double.Greenx = (float)LEDPara_word.Greenx/10000;
  snprintf(LEDPara_string.Greenx, LEDParaStringLength, "%7.6f", LEDPara_double.Greenx);
  sysSetVariableString(sysvarMember::NodeInfo::Node.LED.Greenx, LEDPara_string.Greenx);  
  LEDPara_word.Greeny = (word)DiagCtrl.RespBuf[11]<<8 | (word)DiagCtrl.RespBuf[10];  //10，11
  LEDPara_double.Greeny = (float)LEDPara_word.Greeny/10000;
  snprintf(LEDPara_string.Greeny, LEDParaStringLength, "%7.6f", LEDPara_double.Greeny);
  sysSetVariableString(sysvarMember::NodeInfo::Node.LED.Greeny, LEDPara_string.Greeny); 
  LEDPara_word.GreenL = (dword)DiagCtrl.RespBuf[15]<<24 | (dword)DiagCtrl.RespBuf[14]<<16 |
    (dword)DiagCtrl.RespBuf[13]<<8 | (dword)DiagCtrl.RespBuf[12];  //12，13，14，15
  LEDPara_double.GreenL = (float)LEDPara_word.GreenL/10000;
  snprintf(LEDPara_string.GreenL, LEDParaStringLength, "%7.6f", LEDPara_double.GreenL);
  sysSetVariableString(sysvarMember::NodeInfo::Node.LED.GreenL, LEDPara_string.GreenL);
  
  LEDPara_word.Bluex = (word)DiagCtrl.RespBuf[17]<<8 | (word)DiagCtrl.RespBuf[16];  //16，17
  LEDPara_double.Bluex = (float)LEDPara_word.Greenx/10000;
  snprintf(LEDPara_string.Bluex, LEDParaStringLength, "%7.6f", LEDPara_double.Bluex);
  sysSetVariableString(sysvarMember::NodeInfo::Node.LED.Bluex, LEDPara_string.Bluex);  
  LEDPara_word.Bluey = (word)DiagCtrl.RespBuf[19]<<8 | (word)DiagCtrl.RespBuf[18];  //18，19
  LEDPara_double.Bluey = (float)LEDPara_word.Bluey/10000;
  snprintf(LEDPara_string.Bluey, LEDParaStringLength, "%7.6f", LEDPara_double.Bluey);
  sysSetVariableString(sysvarMember::NodeInfo::Node.LED.Bluey, LEDPara_string.Bluey);  
  LEDPara_word.BlueL = (dword)DiagCtrl.RespBuf[23]<<24 | (dword)DiagCtrl.RespBuf[22]<<16 |
    (dword)DiagCtrl.RespBuf[21]<<8 | (dword)DiagCtrl.RespBuf[20];  //20, 21，22，23
  LEDPara_double.BlueL = (float)LEDPara_word.BlueL/10000;
  snprintf(LEDPara_string.BlueL, LEDParaStringLength, "%7.6f", LEDPara_double.BlueL);
  sysSetVariableString(sysvarMember::NodeInfo::Node.LED.BlueL, LEDPara_string.BlueL);
  
  //Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[19])<<8) | (word)DiagCtrl.RespBuf[18];
  //@sysvarMember::NodeInfo::Node.LFactor = Diag0x22_gWORD;
}


