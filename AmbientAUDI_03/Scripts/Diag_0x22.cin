void local_ProcessPartNo(void)
{
  Diag0x22_gWORD = SID22_SSID[SSID_6269_Partnumber];
  memcpy(Diag0x22_gSTRING, DiagCtrl.RespBuf, Diag0x22_gWORD);
  Diag0x22_gSTRING[Diag0x22_gWORD] = '\0';
  sysSetVariableString(sysvarMember::NodeInfo::Node.PartNumber, Diag0x22_gSTRING); 
}

