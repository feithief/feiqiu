void local_ProcessOptMode(void)
{
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[1])<<8) | (word)DiagCtrl.RespBuf[0];   
  @sysvarMember::NodeInfo::OptPWM.R = Diag0x22_gWORD; 
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[3])<<8) | (word)DiagCtrl.RespBuf[2];   
  @sysvarMember::NodeInfo::OptPWM.G = Diag0x22_gWORD;
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[5])<<8) | (word)DiagCtrl.RespBuf[4];   
  @sysvarMember::NodeInfo::OptADC.VVcc = Diag0x22_gWORD;
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[7])<<8) | (word)DiagCtrl.RespBuf[6];  
  @sysvarMember::NodeInfo::OptADC.TMCU = Diag0x22_gWORD;
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[9])<<8) | (word)DiagCtrl.RespBuf[8];  
  @sysvarMember::NodeInfo::OptADC.VLEDR = Diag0x22_gWORD;
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[11])<<8) | (word)DiagCtrl.RespBuf[10];  
  @sysvarMember::NodeInfo::OptADC.VLEDG = Diag0x22_gWORD;
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[13])<<8) | (word)DiagCtrl.RespBuf[12];  
  @sysvarMember::NodeInfo::OptADC.VLEDB = Diag0x22_gWORD;
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[15])<<8) | (word)DiagCtrl.RespBuf[14]; 
  @sysvarMember::NodeInfo::OptADC.Tled= Diag0x22_gWORD;
}


void local_GetThresholdVals(void)
{
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[1])<<8) | (word)DiagCtrl.RespBuf[0];  
  @sysvarMember::NodeInfo::Threshold.RedOpen = Diag0x22_gWORD;
  
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[3])<<8) | (word)DiagCtrl.RespBuf[2];  
  @sysvarMember::NodeInfo::Threshold.RedShort = Diag0x22_gWORD; 
  
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[5])<<8) | (word)DiagCtrl.RespBuf[4];  
  @sysvarMember::NodeInfo::Threshold.GreenOpen = Diag0x22_gWORD;
  
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[7])<<8) | (word)DiagCtrl.RespBuf[6];  
  @sysvarMember::NodeInfo::Threshold.GreenShort = Diag0x22_gWORD;
  
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[9])<<8) | (word)DiagCtrl.RespBuf[8];  
  @sysvarMember::NodeInfo::Threshold.BlueOpen = Diag0x22_gWORD;
  
  Diag0x22_gWORD = ((word)(DiagCtrl.RespBuf[11])<<8) | (word)DiagCtrl.RespBuf[10];  
  @sysvarMember::NodeInfo::Threshold.BlueShort = Diag0x22_gWORD;
}