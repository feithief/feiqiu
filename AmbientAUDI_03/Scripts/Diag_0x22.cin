/*@!Encoding:936*/
includes
{
  #include "Diag.cin"
}

variables
{
  word Diag0x22_gWORD = 0;
  char Diag0x22_gSTRING[MAXFilePathLength/2];
}


void local_Diag0x22_Prepare(byte NAD, enum ESSID SSID)
{
  Diag_CtrlInit();  
  DiagCtrl.CurrentNAD = NAD;  //new on 2022 12 11在调设备驱动的时候    
  DiagCtrl.Step = DiagStep_ChangeNAD;
  //DiagCtrl.Step = DiagStep_0x22Req;
  DiagCtrl.SID = 0x22;
  DiagCtrl.SSID = SSID;
  DiagCtrl.ReqNAD = 0xa0; //如果不转a0就在这里写NAD
  //DiagCtrl.ReqNAD = 0x7F;
  DiagCtrl.DataLen = SID22_SSID[(enum ESSID)(DiagCtrl.SSID)];
  DiagCtrl.FrameCNT = Tool_GetFrameNum(DiagCtrl.DataLen);
  setTimer(DiagTimer,1);
}


/* 不直接使用local_Diag0x22_Prepare()的原因是 有些旧产品会不转A0 */
/* Supplier ID */
void Public_Send0x22_0002(byte NAD)
{
  local_Diag0x22_Prepare(NAD, SSID_0002_LEDSupplier);
}


