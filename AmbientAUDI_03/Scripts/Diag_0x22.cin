{
  Diag0x22_gWORD = SID22_SSID[SSID_6A69_SerialNum];
  memcpy(Diag0x22_gSTRING, DiagCtrl.RespBuf, Diag0x22_gWORD);
  Diag0x22_gSTRING[Diag0x22_gWORD] = '\0';
  sysSetVariableString(sysvarMember::NodeInfo::Node.SerialNumber, Diag0x22_gSTRING);
}

