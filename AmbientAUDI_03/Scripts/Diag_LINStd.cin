/*@!Encoding:936*/
includes
{
  #include "Diag.cin"
}

variables
{
  linframe 0x3c Diagreq;
  linframe 0x3d Diagrep;
  word StdDiag_gWORD = 0;
  const word StdDiagStrLen = MAXFilePathLength/32; //512/32
  char StdDiag_gSTRING[StdDiagStrLen]; 
}


void StdLIN_B2_ReadByID(byte NAD)
{
  Diag_CtrlInit();
  DiagCtrl.Step = DiagStep_StdLINDiag;
  DiagCtrl.SID = 0xFF;
  DiagCtrl.SSID = 0x00B2;
  DiagCtrl.ReqNAD = NAD;
  DiagCtrl.DataLen = 3; 
  DiagCtrl.FrameCNT = Tool_GetFrameNum(DiagCtrl.DataLen);
  setTimer(DiagTimer,1);
}

void Diag_B2_ReadByID(byte NAD)
{
  Diagreq.MasterReqB0 = NAD;
  Diagreq.MasterReqB1 = 6;
  Diagreq.MasterReqB2 = 0xB2;
  Diagreq.MasterReqB3 = 0;
  Diagreq.MasterReqB4 = 0xFF;
  Diagreq.MasterReqB5 = 0x7F;
  Diagreq.MasterReqB6 = 0xFF;
  Diagreq.MasterReqB7 = 0xFF;
  linTransmitHeader(Diagreq);
  output(Diagreq);
}


void Diag_B0_AssignNAD_wrongData(byte NAD)
{
  Diagreq.MasterReqB0 = NAD;
  Diagreq.MasterReqB1 = 6;
  Diagreq.MasterReqB2 = 0xB0;
  Diagreq.MasterReqB3 = 0x85;
  Diagreq.MasterReqB4 = 0x00;
  Diagreq.MasterReqB5 = 0x03;
  Diagreq.MasterReqB6 = 0x00;
  Diagreq.MasterReqB7 = 0x05;
  linTransmitHeader(Diagreq);
  output(Diagreq);
}


void StdLIN_B0_AssignNAD_wrongData(byte NAD)
{
  Diag_CtrlInit();
  DiagCtrl.Step = DiagStep_StdLINDiag;
  DiagCtrl.SID = 0xFF;
  DiagCtrl.SSID = 0x00B0;
  DiagCtrl.ReqNAD = NAD;
  DiagCtrl.DataLen = 3; 
  DiagCtrl.FrameCNT = Tool_GetFrameNum(DiagCtrl.DataLen);
  setTimer(DiagTimer,1);
}

