void Diag_B1_AssignFrameID(byte NAD, byte OldFrameID, byte NewFrameID)
{
  dword PID;
  Diagreq.MasterReqB0= NAD;
  Diagreq.MasterReqB1= 0x06;
  Diagreq.MasterReqB2 = 0xb1;
  Diagreq.MasterReqB3 = 0x84; //(byte)(Private_SupplierID_KBD&0x00ff);
  Diagreq.MasterReqB4 = 0x00; //(byte)((Private_SupplierID_KBD&0xff00)>>8);
  Diagreq.MasterReqB5 = OldFrameID;
  Diagreq.MasterReqB6 = 0x40;
  PID = linGetProtectedID((long)NewFrameID);
  Diagreq.MasterReqB7 = (byte)PID;
  linTransmitHeader(Diagreq);
  output(Diagreq);
}

void StdLIN_AssignFrameID(byte NAD,byte FrameID)
{
  Diag_CtrlInit();
  DiagCtrl.Step = DiagStep_StdLINDiag;
  DiagCtrl.SID = 0xFF;
  DiagCtrl.SSID = 0x00B1;
  DiagCtrl.ReqNAD = NAD;
  DiagCtrl.DataLen = 3; 
  DiagCtrl.FrameCNT = 1;//Tool_GetFrameNum(DiagCtrl.DataLen);
  setTimer(DiagTimer,10);
}


void StdDiag_ReadProcess(void)
{
  switch(DiagCtrl.SSID)
  {
    case 0xB2:
      //write("%x %x %x %x %x", DiagCtrl.RespBuf[0], DiagCtrl.RespBuf[1], DiagCtrl.RespBuf[2], DiagCtrl.RespBuf[3], DiagCtrl.RespBuf[4]);
      StdDiag_gWORD = ((word)(DiagCtrl.RespBuf[1])<<8) | (word)DiagCtrl.RespBuf[0];
      snprintf(StdDiag_gSTRING, StdDiagStrLen,"0x%x", StdDiag_gWORD);
      sysSetVariableString(sysvarMember::NodeInfo::Node.SupplierID, StdDiag_gSTRING);
      
      StdDiag_gWORD = ((word)(DiagCtrl.RespBuf[3])<<8) | (word)DiagCtrl.RespBuf[2];
      snprintf(StdDiag_gSTRING, StdDiagStrLen,"0x%x", StdDiag_gWORD);
      sysSetVariableString(sysvarMember::NodeInfo::Node.FunctionID, StdDiag_gSTRING);
      
      snprintf(StdDiag_gSTRING, StdDiagStrLen,"0x%x", DiagCtrl.RespBuf[4]);
      sysSetVariableString(sysvarMember::NodeInfo::Node.SubVersion, StdDiag_gSTRING);
      break;
    case 0xB1:
      write("Process B1 . Do nothing. <void StdDiag_ReadProcess(void)>");
      break;
  }

  
}

