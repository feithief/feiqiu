/*@!Encoding:936*/
includes
{
  #include "Diag.cin"
}

variables
{
  word Diag0x2E_gWORD = 0;
  char Diag0x2E_gSTRING[MAXFilePathLength/2];
  word Diag0x2E_gCNT = 0;
}


void local_Diag0x2E_Prepare(byte NAD, enum ESSID SSID)
{
  Diag_CtrlInit();
  DiagCtrl.CurrentNAD = NAD;
  DiagCtrl.Step = DiagStep_ChangeNAD;
  DiagCtrl.SID = 0x2E;
  DiagCtrl.SSID = SSID;
  DiagCtrl.ReqNAD = 0xa0; //如果不转a0就在这里写NAD
  DiagCtrl.DataLen = SID2E_SSID[(enum ESSID)(DiagCtrl.SSID)];
  DiagCtrl.FrameCNT = Tool_GetFrameNum(DiagCtrl.DataLen);
  setTimer(DiagTimer, SchTableTimeSlot*3);
}


/* HW Version */
void Public_Send0x2E_6869(byte NAD, sysvarString* SysHWVersion)
{
  local_Diag0x2E_Prepare(NAD, SSID_6869_HWVersion);  
  Diag0x2E_gWORD = SID2E_SSID[SSID_6869_HWVersion] + 1;
  //sysGetVariableString(sysvarMember::NodeInfo::Node.HWVersion, Diag0x2E_gSTRING, Diag0x2E_gWORD);
  sysGetVariableString(SysHWVersion, Diag0x2E_gSTRING, Diag0x2E_gWORD);
  for(Diag0x2E_gCNT=0; Diag0x2E_gCNT<Diag0x2E_gWORD; Diag0x2E_gCNT++)
  {
    if((Diag0x2E_gSTRING[Diag0x2E_gCNT]>='a') &&(Diag0x2E_gSTRING[Diag0x2E_gCNT]<='z') )
    {
      Diag0x2E_gSTRING[Diag0x2E_gCNT] = Diag0x2E_gSTRING[Diag0x2E_gCNT]-32;
    }
    DiagCtrl.ReqBuf[Diag0x2E_gCNT] = (byte)Diag0x2E_gSTRING[Diag0x2E_gCNT];
  }  
}



/* 不直接使用local_Diag0x2EPrepare()的原因是 有些旧产品会不转A0 */
/* Supplier ID */
void Public_Send0x2E_0002(byte NAD)
{
  local_Diag0x2E_Prepare(NAD, SSID_0002_LEDSupplier);
  
  Diag0x2E_gWORD = 2;
  DiagCtrl.ReqBuf[0]=0;
  DiagCtrl.ReqBuf[1]=0;
}


/* NAD */
void Public_Send0x2E_0003(byte NAD, sysvarInt* SysNAD)
{
  local_Diag0x2E_Prepare(NAD, SSID_0003_SingleAddress);
  Diag0x2E_gWORD = SID2E_SSID[SSID_0003_SingleAddress];
  
  Diag0x2E_gCNT = @SysNAD;
  DiagCtrl.ReqBuf[0] = (byte)(Diag0x2E_gCNT & 0x00ff);
  DiagCtrl.ReqBuf[1] = (byte)((Diag0x2E_gCNT&0xff00)>>8);   
}

/* GroupAddr */
void Public_Send0x2E_0004(byte NAD, sysvarInt* SysGaddr)
{
  local_Diag0x2E_Prepare(NAD, SSID_0004_GroupAddress);
  Diag0x2E_gWORD = SID2E_SSID[SSID_0004_GroupAddress];
  
  Diag0x2E_gCNT = @SysGaddr;
  DiagCtrl.ReqBuf[0] = (byte)(Diag0x2E_gCNT & 0x00ff);
  DiagCtrl.ReqBuf[1] = (byte)((Diag0x2E_gCNT&0xff00)>>8);    
}


/* LFactor */
void Public_Send0x2E_0006(byte NAD, sysvarInt* SysLFactor)
{
  local_Diag0x2E_Prepare(NAD, SSID_0006_Factor);
  Diag0x2E_gWORD = SID2E_SSID[SSID_0006_Factor];
  Diag0x2E_gCNT = (word)@SysLFactor;
  DiagCtrl.ReqBuf[0] = (byte)(Diag0x2E_gCNT & 0x00ff);
  DiagCtrl.ReqBuf[1] = (byte)((Diag0x2E_gCNT&0xff00)>>8); 
}

/* Redx */
void Public_Send0x2E_0007(byte NAD)
{  
  local_Diag0x2E_Prepare(NAD, SSID_0007_Redx);
  sysGetVariableString(sysvarMember::NodeInfo::Node.LED.Redx, LEDPara_string.Redx, LEDParaStringLength);
  //write("LEDPara_string.Redx = %s",LEDPara_string.Redx);
  strtod(LEDPara_string.Redx,LEDPara_double.Redx);
  //write("LEDPara_double.Redx=%f",LEDPara_double.Redx);
  LEDPara_word.Redx = (word)(_round(LEDPara_double.Redx * 10000));
  //write("LEDPara_word.Redx=%d",LEDPara_word.Redx);
  DiagCtrl.ReqBuf[0] = (byte)(LEDPara_word.Redx & 0x00ff);
  DiagCtrl.ReqBuf[1] = (byte)((LEDPara_word.Redx&0xff00)>>8);  
  sysGetVariableString(sysvarMember::NodeInfo::Node.LED.Redy, LEDPara_string.Redy, LEDParaStringLength);
  strtod(LEDPara_string.Redy,LEDPara_double.Redy);
  //write("LEDPara_double.Redy=%f",LEDPara_double.Redy);
  LEDPara_word.Redy = (word)(_round(LEDPara_double.Redy * 10000));
  //write("LEDPara_word.Redy=%d",LEDPara_word.Redy);
  DiagCtrl.ReqBuf[2] = (byte)(LEDPara_word.Redy & 0x00ff);
  DiagCtrl.ReqBuf[3] = (byte)((LEDPara_word.Redy&0xff00)>>8);  
  sysGetVariableString(sysvarMember::NodeInfo::Node.LED.RedL,LEDPara_string.RedL,LEDParaStringLength); 
  strtod(LEDPara_string.RedL,LEDPara_double.RedL);
  //write("LEDPara_double.RedL=%f",LEDPara_double.RedL);
  LEDPara_word.RedL = (dword)(_round(LEDPara_double.RedL * 10000));
  //write("LEDPara_word.RedL=%d",LEDPara_word.RedL);
  DiagCtrl.ReqBuf[4] = (byte)(LEDPara_word.RedL & 0x000000ff);
  DiagCtrl.ReqBuf[5] = (byte)((LEDPara_word.RedL&0x0000ff00)>>8);
  DiagCtrl.ReqBuf[6] = (byte)((LEDPara_word.RedL&0x00ff0000)>>16);
  DiagCtrl.ReqBuf[7] = (byte)((LEDPara_word.RedL&0xff000000)>>24); 
}

