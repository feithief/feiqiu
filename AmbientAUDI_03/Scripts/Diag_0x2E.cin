/* Platform */
void Public_Send0x2E_0005(byte NAD, sysvarInt* SysPlatform)
{
  local_Diag0x2E_Prepare(NAD, SSID_0005_Platform);
  Diag0x2E_gWORD = SID2E_SSID[SSID_0005_Platform];
  Diag0x2E_gCNT = @SysPlatform;
  DiagCtrl.ReqBuf[0] = (byte)(Diag0x2E_gCNT & 0x00ff);
  DiagCtrl.ReqBuf[1] = (byte)((Diag0x2E_gCNT&0xff00)>>8); 
}


void Public_Set3PWMs(word NAD, word PWMR, word PWMG, word PWMB)
{  
  local_Diag0x2E_Prepare(NAD, SSID_000B_Meas);
  DiagCtrl.ReqBuf[0] = 1;
  DiagCtrl.ReqBuf[1] = (byte)(PWMR & 0x00ff);
  DiagCtrl.ReqBuf[2] = (byte)((PWMR & 0xff00)>>8); 
  DiagCtrl.ReqBuf[3] = (byte)(PWMG & 0x00ff);
  DiagCtrl.ReqBuf[4] = (byte)((PWMG & 0xff00)>>8); 
  DiagCtrl.ReqBuf[5] = (byte)(PWMB & 0x00ff);
  DiagCtrl.ReqBuf[6] = (byte)((PWMB & 0xff00)>>8); 
}


void Public_Send0x2E_LeaveSetPWM(void)
{
  local_Diag0x2E_Prepare(0xa0, SSID_000B_Meas);
  DiagCtrl.ReqBuf[0] = 0;
  DiagCtrl.ReqBuf[1] = 0;
  DiagCtrl.ReqBuf[2] = 0;
  DiagCtrl.ReqBuf[3] = 0;
  DiagCtrl.ReqBuf[4] = 0;
  DiagCtrl.ReqBuf[5] = 0;
  DiagCtrl.ReqBuf[6] = 0;
}

/* Lock */
void Public_Send0x2E_000C(byte NAD)
{
  /* 1. read Flag */
  Public_Send0x22_000C(NAD);
  Diag0x2E_gWORD = @NodeInfo::Node.CtrlFlag;
 // write("Flag = %x, %d", Diag0x2E_gWORD, Diag0x2E_gWORD);
  testWaitForTimeout(500);
  /* 2. Lock */
  Diag0x2E_gWORD = Diag0x2E_gWORD | 0x0080;
  @NodeInfo::Node.CtrlFlag = Diag0x2E_gWORD;
  local_Diag0x2E_Prepare(NAD, SSID_000C_Flag);  
  DiagCtrl.ReqBuf[0] = (byte)(Diag0x2E_gWORD & 0x00ff);
  DiagCtrl.ReqBuf[1] = (byte)((Diag0x2E_gWORD & 0xff00)>>8); 
}


void Public_Send0x2E_0101(byte NAD)
{
  local_Diag0x2E_Prepare(NAD, SSID_0101_Threshold);
  
  Diag0x2E_gWORD = @sysvarMember::NodeInfo::Threshold.RedOpen;
  DiagCtrl.ReqBuf[0] = (byte)(Diag0x2E_gWORD & 0x00ff);
  DiagCtrl.ReqBuf[1] = (byte)((Diag0x2E_gWORD & 0xff00)>>8);  
  
  Diag0x2E_gWORD = @sysvarMember::NodeInfo::Threshold.RedShort;
  DiagCtrl.ReqBuf[2] = (byte)(Diag0x2E_gWORD & 0x00ff);
  DiagCtrl.ReqBuf[3] = (byte)((Diag0x2E_gWORD & 0xff00)>>8); 
  
  Diag0x2E_gWORD = @sysvarMember::NodeInfo::Threshold.GreenOpen;
  DiagCtrl.ReqBuf[4] = (byte)(Diag0x2E_gWORD & 0x00ff);
  DiagCtrl.ReqBuf[5] = (byte)((Diag0x2E_gWORD & 0xff00)>>8); 
  
  Diag0x2E_gWORD = @sysvarMember::NodeInfo::Threshold.GreenShort;
  DiagCtrl.ReqBuf[6] = (byte)(Diag0x2E_gWORD & 0x00ff);
  DiagCtrl.ReqBuf[7] = (byte)((Diag0x2E_gWORD & 0xff00)>>8); 
  
  Diag0x2E_gWORD = @sysvarMember::NodeInfo::Threshold.BlueOpen;
  DiagCtrl.ReqBuf[8] = (byte)(Diag0x2E_gWORD & 0x00ff);
  DiagCtrl.ReqBuf[9] = (byte)((Diag0x2E_gWORD & 0xff00)>>8); 
  
  Diag0x2E_gWORD = @sysvarMember::NodeInfo::Threshold.BlueShort;
  DiagCtrl.ReqBuf[10] = (byte)(Diag0x2E_gWORD & 0x00ff);
  DiagCtrl.ReqBuf[11] = (byte)((Diag0x2E_gWORD & 0xff00)>>8); 
}

