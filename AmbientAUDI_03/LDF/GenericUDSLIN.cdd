</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control</TUV>
</DESC>
<QUAL>Normal_11Bit.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C87CD0' oid='63B9311EF7854bf2B11CEC2C57BCBBC1' temploid='54535796EE3C4c21A91E96C4F6A8496B' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
