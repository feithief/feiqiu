<NAME>
<TUV xml:lang='en-US'>Mixed 11Bit</TUV>
</NAME>
<QUAL>Mixed_11Bit</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>not supported</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>supported</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020CC5250' oid='4C5284E52A1D4ade8071627CAAF86779' temploid='D53DDD6AA44E426a853518C9222F12F4' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
