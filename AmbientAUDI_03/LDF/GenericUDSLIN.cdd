</NAME>
<DESC>
<TUV xml:lang='en-US'>Fill byte used for filling CAN frames to eight byte length.</TUV>
</DESC>
<QUAL>Normal_11Bit.CANFrameFillerByte</QUAL>
</UNSDEF>
<ENUMDEF id='_0000000020C79C80' oid='E008AE97D5584dfcB9445F7FA8601447' temploid='D1C3ECD503524f02B39DA87F588C3D2F' attrcatref='_00000000053B63C0' usage='sys' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FillerByteHandling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enables use of fill bytes; if "true", fill bytes are used, otherwise DLC may be smaller than 8.</TUV>
</DESC>
<QUAL>Normal_11Bit.FillerByteHandling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>false</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>true</TUV>
</ETAG>
</ENUMDEF>
