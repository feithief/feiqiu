</ETAG>
</ENUMDEF>
<UNSDEF id='_0000000020C69200' oid='6A13FBE7A56745e8931791B5F65BC458' temploid='85F2E27AED734b3bBDBED0D879A97FCC' attrcatref='_00000000053B63C0' usage='admin' v='10400' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Represents the desired baud rate. If the desired  baud  rate  cannot  be  achieved  within  the tolerance of the protocol, the interface will remain at the previous baud rate.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_Baudrate</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C693B0' oid='3E647184E94049bf9FEAC61ECB3D2528' temploid='6D52A185CBDF48ee9AEF2D709B71FE5C' attrcatref='_00000000053B63C0' usage='admin' v='233' df='hex'>
<NAME>
<TUV xml:lang='en-US'>EcuAddress</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Physical diagnostic address of the ECU.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_PhysReqTargetAddr</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C69560' oid='57B03B47854140c18E98749B71E4B67C' temploid='AD691E1AB8344d16A265ED1E5444A170' attrcatref='_00000000053B63C0' usage='admin' v='241' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterAddress</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Using this Addressing Scheme, the Tester Address can not be determined by the ECU during runtime. Therefore the Tester Address has to be fixed.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_TesterSourceAddress</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C69710' oid='CC56FD368ED145deB0A22FBC467D78B2' temploid='365F9AF8B3574c1583A973DB4DFC4A45' attrcatref='_00000000053B63C0' usage='admin' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>BroadcastAddress</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the target address for functionally transmitted requests. If this parameter is 0x00, no functional addressing is used.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_FuncReqTargetAddr</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C698C0' oid='C8099D555FDB44a49682309D21547BD9' temploid='558249ED08234f329E115A7823022D7A' attrcatref='_00000000053B63C0' usage='admin' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>5BaudInitAddress</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Value of 5Baud Address in case of physical-addressed communication.
The correct baud rate address type (functional/physical) is selected during execution of a 
Start Communication  Com Primitive based on the setting of the CP_RequestAddrMode 
ComParam.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_5BaudAddressPhys</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C69A70' oid='5A996DEAD0F64ce38CEA9B528F1E1749' temploid='0E3BE6E13C3A4dfe94AEE136CB6BCB3E' attrcatref='_00000000053B63C0' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>HeaderFormatKW</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Header Byte configuration for K-Line protocols (Keyword).
This  setting  is  used  to  properly  construct  the  message header bytes to complete the
PDU. This ComParam is not used if the ComLogicalLink is in RawMode.
Header bytes are constructed following
 the rules of the protocol specification. This ComParam
can be used to override any keybyte values received from the ECU during
initialization.

Value: [0; 8]

0 = Use the header byte format specified by the ECU key bytes
1 = 1 Byte Only (max size = 0x3F)
2 = 2 Bytes (dependent on length)
3 = 2 Bytes always
4 = 3 Bytes Only
5 = 4 Bytes (dependent on length)
6 = 4 Bytes always
7 = OEM-9141 Header Format (ms nibble of first byte = byte count)
8 = No header bytes </TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_HeaderFormatKW</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C69C20' oid='5B881A1E5A2E47b38E27761A836EC82F' temploid='39AA41D6ABAF41ba97990B112BC1DBC0' attrcatref='_00000000053B63C0' usage='admin' v='1' df='dec'>
<NAME>
<TUV xml:lang='en-US'>InitializationSettings</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'> Set initialization method.

 1 = 5 Baud Init sequence
 2 = Fast Init sequence
 3 = No Init sequence</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_InitializationSettings</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C6F060' oid='C64E482976BF40f8BD7919ABCA852E84' temploid='68C03E28FAA44292B7F8B20B0D55B3F9' attrcatref='_00000000053B6A50' usage='admin' v='300' df='dec'>
<NAME>
<TUV xml:lang='en-US'>TIdle</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum bus idle time before tester starts the										   address byte sequence or the fast init sequence. </TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_TIdle</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C6F210' oid='4F930012B6084f40B914DB98BFC8C83F' temploid='8CECCEA84B4A48e9B10737379B5CF70A' attrcatref='_00000000053B6A50' usage='admin' v='300' df='dec'>
<NAME>
<TUV xml:lang='en-US'>W1</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Maximum time from the end of address byte to start of the synchronization pattern from the ECU.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_W1Max</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C6F3C0' oid='B50E7E464F3945cc8AA4D8E843B37322' temploid='9E92A1F57E2D41df940A87036F45AB02' attrcatref='_00000000053B6A50' usage='admin' v='20' df='dec'>
<NAME>
<TUV xml:lang='en-US'>W2</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Maximum time from the end of the synchronization pattern to the start of key byte 1.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_W2Max</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C6F570' oid='633A5935CF554c7fA56E3222C121BCE2' temploid='D0A3C40686DF4205B6361AC02A7B270E' attrcatref='_00000000053B6A50' usage='admin' v='20' df='dec'>
<NAME>
<TUV xml:lang='en-US'>W3</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Maximum time between key byte 1 and key byte 2.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_W3Max</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C6F720' oid='E3224738AB3D409383D9B906E3489B47' temploid='638E5E60BFC94c98B302EA62A2E92B0E' attrcatref='_00000000053B6A50' usage='admin' v='25' df='dec'>
<NAME>
<TUV xml:lang='en-US'>W4Min</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time between receiving key byte 2 from the vehicle and the inversion being returned 
by the interface. Same is true for the inverted key byte 2 sent by the tester and the  received 
inverted address from the vehicle.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_W4Min</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C6F8D0' oid='948AA74201D04132A8D57BA22DEC857C' temploid='73C3A8CB014B4db9867D4EA8F0A01D6B' attrcatref='_00000000053B6A50' usage='admin' v='50' df='dec'>
<NAME>
<TUV xml:lang='en-US'>W4Max</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Maximum time between receiving key byte 2 from the vehicle and the inversion being 
returned by the interface. Same is true for the inverted key byte 2 sent by the tester and the 
received inverted address from the vehicle.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_W4Max</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C6FA80' oid='E312829713D3408fB2BC843C4D689D41' temploid='C93A5F1885784e7691D1425BDFDAAE94' attrcatref='_00000000053B6A50' usage='admin' v='200' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Timeout in receiving an expected frame after a successful transmit complete. Also used for multiple ECU responses.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_P2Max</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C6FC30' oid='762C1CD7F5CA435d9A770C101EAEC9CB' temploid='980D222CFF304fe99A52729ACDDC927D' attrcatref='_00000000053B6A50' usage='admin' v='50' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Timeout in receiving an expected frame after a successful transmit complete. Also used for multiple ECU responses.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_P2Max_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C6FDE0' oid='266277E281E046148E28F53F808BAA3D' temploid='577A0923FED74673933646B1F0731564' attrcatref='_00000000053B6A50' usage='admin' v='6000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2ExClient</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enhanced timeout for the client to wait after the reception of a negative response message with response code 78 hex for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_P2Star</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C72060' oid='6BF1DD9FFCBA4e698E616A41ABF13063' temploid='4F9F782C74A843109BB17427F7822193' attrcatref='_00000000053B6A50' usage='admin' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2ExServer</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time  between end of ECU responses and start of new tester request.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_P3Max_Ecu</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C72210' oid='99DF702B3EBD4de19B99EDE01834E36A' temploid='C147C24822F04c20968981D11BD3225D' attrcatref='_00000000053B6A50' usage='admin' v='55' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3Min</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time between end of non-negative ECU responses and start of new request. The interface will accept all responses up to CP_P3Min time. The interface will allow transmission of a request any time after CP_P3Min. (See CP_RC21RequestTime for minimum time between end of ECU negative responses and start of new requests.)</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_P3Min</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C723C0' oid='3FB1B60D7FC541a09EC2522F4BCDF307' temploid='57CD7C75B62D4ea39019A22ACDAE916E' attrcatref='_00000000053B6A50' usage='admin' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P4Min</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum inter-byte time for tester transmits.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_P4Min</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C72570' oid='469E56A8FE57489eBA663D65DE3351C2' temploid='C5FB51686CEB4d2295CEA0C2E38E3BBC' attrcatref='_00000000053B6A50' usage='admin' v='4000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between functionally addressed Tester Present request messages transmitted by the client to keep a diagnostic session other than the defaultSession active in multiple servers (functional communication) or maximum time between physically transmitted request messages to a single server (physical communication).</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_TesterPresentTime</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C72720' oid='70B08DE07A7348a58DCE014ADDA42A0F' temploid='984491F022F34edf8655E809054A73F7' attrcatref='_00000000053B6A50' usage='admin' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for the server to keep a diagnostic session other than the defaultSession active while not receiving any diagnostic request message.</TUV>
</DESC>
<QUAL>K_Line_5BaudInitCommonDiagnostics.CP_TesterPresentTime_Ecu</QUAL>
</UNSDEF>
<ENUMDEF id='_0000000020C56440' oid='DFABEDC5F63D49ffA31F273EC7C1F388' temploid='300075B3FD5D44cfBD87A8E9ECD62C45' attrcatref='_00000000053B6660' usage='sys' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Normal 11Bit</TUV>
</NAME>
<QUAL>Normal_11Bit</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>not supported</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>supported</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020C565E0' oid='BADCBFBEE3BA41beA136C7A72DD5E15D' temploid='11395FF76C6A49bdA82A205A80B66EDD' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Bus Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of transport media</TUV>
</DESC>
<QUAL>Normal_11Bit.BusType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>CAN</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020C79460' oid='2CFAE4C85DDC4ddb8D292E447254127A' temploid='36CCE31446F74423BC32BE953236588B' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Transport Protocol Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of used Transport Protocol (e.g. ISO15765)</TUV>
</DESC>
<QUAL>Normal_11Bit.TransportProtocolType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>ISO15765</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020C79600' oid='D7F99D4438884fbc8D159D2337BC250F' temploid='ECE5FA3FBF69403995DC90FD8941F2C2' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Addressing Scheme</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Addressing Scheme used for physical requests and responses.</TUV>
</DESC>
<QUAL>Normal_11Bit.AddrScheme</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Normal</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020C797A0' oid='3399ED47785D499eAFE0922ACC9162F7' temploid='3B87E11FE5244bb2889AA3C4039BC58C' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>CAN-ID Type used for physical requests and responses</TUV>
</DESC>
<QUAL>Normal_11Bit.CanIdType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000000020C728D0' oid='BBE3EA8F8536424d91DCDBC03456D79D' temploid='721051E9F9B44388BB80FD4507B36620' attrcatref='_00000000053B63C0' usage='sys' v='1792' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for physical requests. The hex value not only describes the identifier but also the priority of the message. The higher the number, the lower the priority. </TUV>
</DESC>
<QUAL>Normal_11Bit.ReqCanId</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C72A80' oid='AC9ABC4733EA40a79C99D96A91823F54' temploid='97A0C3934570440aBB542848175044F9' attrcatref='_00000000053B63C0' usage='sys' v='1536' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Response CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The response CAN identifier for physical responses.The response for functional requests is sent via the physical path.</TUV>
</DESC>
<QUAL>Normal_11Bit.ResCanId</QUAL>
</UNSDEF>
<ENUMDEF id='_0000000020C79940' oid='DD0A48B4FBFB460cBDFE37AC3D59A4F8' temploid='054C56D048A04f04AE648363EC066CC8' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Functional Addressing Scheme</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Addressing Scheme used for functional requests.</TUV>
</DESC>
<QUAL>Normal_11Bit.AddrSchemeFunc</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>Normal</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020C79AE0' oid='FE682EBFAF3C45d5BE9CE0015C4AF0F3' temploid='E27A489CBCB148e583DBE579008F8694' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Functional CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>CAN-ID Type used for functional request</TUV>
</DESC>
<QUAL>Normal_11Bit.CanIdTypeFunc</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000000020C72C30' oid='037D483174454598AA7985315809E4CC' temploid='29B90E5A02DE46baA8EF7BBE6621F4B8' attrcatref='_00000000053B63C0' usage='sys' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Functional Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for functional requests.</TUV>
</DESC>
<QUAL>Normal_11Bit.ReqCanIdFunc</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C72DE0' oid='A445EF2D199E4b3e800EEAA74B05398F' temploid='4259BE29CE6244bc916A27335A0607F9' attrcatref='_00000000053B6A50' usage='sys' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Timeout for the client to wait after the successful transmission of a request message for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>Normal_11Bit.P2Client</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C7F460' oid='ADE402B4FA3443ccA2C9C4B709B2C217' temploid='0C0E5D83A27C4188BAEF965D014C57AD' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the reception of a request message. In UDS this is the timeout for the default session.The tester will also require the P2Server timeout, since in UDS service "DiagnosticSessionControl"returns the P2Server and P2*Server timeouts – the tester has to calculate the offset manually and has to add it to the returned P2Server and P2*Server timeouts.</TUV>
</DESC>
<QUAL>Normal_11Bit.P2Server</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C7F610' oid='4045D97B956C4514A86A59E2F02AE998' temploid='302CF8C31C4844c3BC59BA4DCE7B0F3A' attrcatref='_00000000053B6A50' usage='sys' v='2000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2*Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enhanced timeout for the client to wait after the reception of a negative response message with response code 78 hex for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>Normal_11Bit.P2ExClient</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C7F7C0' oid='7A9D3A9427A14dd6A926E79CF5B71CC0' temploid='EB4E975721964cdaB59ECD345FE6F9A2' attrcatref='_00000000053B6A50' usage='sys' v='1950' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2*Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the transmission of a negative response message with response code 78 hex (enhanced response timing). In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>Normal_11Bit.P2ExServer</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C7F970' oid='31B2361F7450422f8A9C6CB1BE3CDFB0' temploid='4EA4CBDDEBC34046A32EEFA330CD64BC' attrcatref='_00000000053B6A50' usage='sys' v='4000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between functionally addressed Tester Present request messages transmitted by the client to keep a diagnostic session other than the defaultSession active in multiple servers (functional communication) or maximum time between physically transmitted request messages to a single server (physical communication).</TUV>
</DESC>
<QUAL>Normal_11Bit.S3Client</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C7FB20' oid='D08B4143FF5442b7B4878D0CE4703F41' temploid='238C5FE8013A4583B806BFD788612E65' attrcatref='_00000000053B6A50' usage='sys' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for the server to keep a diagnostic session other than the defaultSession active while not receiving any diagnostic request message</TUV>
</DESC>
<QUAL>Normal_11Bit.S3Server</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C7FCD0' oid='E4285361F3C54dbdB6846F84D36C0F07' temploid='6AB8CAB2212040a4A6080687DC1939EA' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a physically addressed request message (indicated via N_USData.con) with no response required before it can transmit the next physically addressed request message.
Minimum value = P2Server</TUV>
</DESC>
<QUAL>Normal_11Bit.P3ClientPhys</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C7FE80' oid='353ECC2EC7F84730AD6758F7B22B26D7' temploid='7BFC10E5ABA44e27B2E3DD46B5F8FA21' attrcatref='_00000000053B63C0' usage='sys' v='15872' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterPresentPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the TesterPresent message for physically addressed requests used to keep a diagnostic session active.</TUV>
</DESC>
<QUAL>Normal_11Bit.TesterPresentPhys</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C80030' oid='D2AFD9CB55DB4fbeAD7788F439727734' temploid='2FCF44F2B4734688B731EC54B3DA3FBD' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientFunc</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a functionally addressed request message (indicated via N_USData.con) before it can transmit the next functionally addressed request message in case no response is required or the requested data is only supported by a subset of the functionally addressed servers.
Minimum value = P2Server.</TUV>
</DESC>
<QUAL>Normal_11Bit.P3ClientFunc</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C801E0' oid='398B1BBAA5444987A2BD2213A8C7BCC2' temploid='D62CC39EE7A140a7996492599EF60BDA' attrcatref='_00000000053B63C0' usage='sys' v='16000' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterPresentFunc</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the TesterPresent message for functionally addressed requests used to keep a diagnostic session active.</TUV>
</DESC>
<QUAL>Normal_11Bit.TesterPresentFunc</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C87460' oid='5A82DBB40A08497d803D8141C68D5D84' temploid='4B925E67D6C144b4898A6E13695D58FE' attrcatref='_00000000053B6A50' usage='sys' v='20' df='dec'>
<NAME>
<TUV xml:lang='en-US'>STmin</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>(Separation Time) defines the minimum time gap between consecutive frames.Values from 0x00 to 0x7F (0 – 127) are absolute milliseconds.Values from 0xF1 to 0xF9 are even 100 micro seconds.Every other value range is reserved and should not be used.</TUV>
</DESC>
<QUAL>Normal_11Bit.StMin</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C87610' oid='1893780FEC6546589CBA58A59060AA24' temploid='0687B6F96FE64f9e9C9213BA615751FC' attrcatref='_00000000053B63C0' usage='sys' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Blocksize</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The Blocksize parameter indicates, how many consecutive frames shall be sent in a transmission before a flow control frame is sent. The number 0 tells the sender, that no more flow controls should disrupt the sending of the remaining flow controls</TUV>
</DESC>
<QUAL>Normal_11Bit.Blocksize</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C877C0' oid='D1E8D67F99464ae6954C254316C661D8' temploid='FC93C9B1727A43089BCCC07EA986AA0E' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout As</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, sender side</TUV>
</DESC>
<QUAL>Normal_11Bit.TimeoutAs</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C87970' oid='553EE8E16FE6494eAB9EB4FE21B1B3B7' temploid='71ECF0D9125B4f0d9623DA89FF7B97C4' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Ar</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, receiver side</TUV>
</DESC>
<QUAL>Normal_11Bit.TimeoutAr</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C87B20' oid='716F4C7B73564e7d844FF60C3D496885' temploid='87A4650EE3FB47da9600F1B7BF0291BA' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
