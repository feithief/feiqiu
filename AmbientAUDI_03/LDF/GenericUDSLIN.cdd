<TUV xml:lang='en-US'>Time until reception of next consecutive frame</TUV>
</DESC>
<QUAL>Normal_29Bit.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CA70D0' oid='EFFD52E31D8749488A72321DB4B46043' temploid='60FC44CBD3784df88E452FF087D43BED' attrcatref='_00000000053B63C0' usage='sys' v='4095' df='dec'>
<NAME>
