<ENUMDEF id='_0000000020CC5590' oid='7A01696F14B642538270AA425EBC4800' temploid='96B38F8252D64c78A9C756A2A850286C' attrcatref='_00000000053B63C0' usage='sys' v='3' sort='id'>
<NAME>
