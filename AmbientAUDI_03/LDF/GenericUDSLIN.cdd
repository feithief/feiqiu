</NAME>
<QUAL>Extended_11Bit</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>not supported</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>supported</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020C91220' oid='D3E240A6A50C4e9c90750FB18EC9AFB1' temploid='EB2CA39771FE4bed9DB7D0F93FAA525E' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Bus Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of transport media</TUV>
</DESC>
<QUAL>Extended_11Bit.BusType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>CAN</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020C913C0' oid='9A8B0810B14B466bA3C66A15662DA801' temploid='9D88FF6464AE49f094737FD4A68DDF57' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Transport Protocol Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of used Transport Protocol (e.g. ISO15765)</TUV>
</DESC>
<QUAL>Extended_11Bit.TransportProtocolType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>ISO15765</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020C91560' oid='6C0BF595B93F4179B134EC09589CDDE3' temploid='C56C6168E4BD4bfbB3BE7A61A95A09A2' attrcatref='_00000000053B63C0' usage='sys' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Addressing Scheme</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Addressing Scheme used for physical requests and responses.</TUV>
</DESC>
<QUAL>Extended_11Bit.AddrScheme</QUAL>
<ETAG v='1'>
<TUV xml:lang='en-US'>Extended</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020CAC060' oid='5A60D52F441648c188770B97C38BE052' temploid='4F1AD3AE41E34c47AEED0BD5E0BB9129' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>CAN-ID Type used for physical requests and responses</TUV>
</DESC>
<QUAL>Extended_11Bit.CanIdType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000000020CA75E0' oid='F3866CC7B87145d28C0EEA817387C968' temploid='4ECF0B3F6F4A4f46A3A71BED244F5A97' attrcatref='_00000000053B63C0' usage='sys' v='1792' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for physical requests. The hex value not only describes the identifier but also the priority of the message. The higher the number, the lower the priority. </TUV>
</DESC>
<QUAL>Extended_11Bit.ReqCanId</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAD060' oid='BF78D74D5B8B4728BCC143F17F0827F1' temploid='F0F1601B51C243b48666DACA21EBF481' attrcatref='_00000000053B63C0' usage='sys' v='1536' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Response CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The response CAN identifier for physical responses.The response for functional requests is sent via the physical path.</TUV>
</DESC>
<QUAL>Extended_11Bit.ResCanId</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAD210' oid='B6A81E4E349C4f14B67BE577F98509E7' temploid='60E36845C3FE47e5B471FF20C92B3091' attrcatref='_00000000053B63C0' usage='sys' v='1' df='hex'>
<NAME>
<TUV xml:lang='en-US'>ECU Address</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Physical diagnostic address of the ECU.</TUV>
</DESC>
<QUAL>Extended_11Bit.EcuAddress</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAD3C0' oid='ED0067740A6B43a8ABF42B7420A54AAA' temploid='D67FD793CFAB484cBB9C1E76A5DEE0D2' attrcatref='_00000000053B63C0' usage='sys' v='241' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Tester Address</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Using this Addressing Scheme, the Tester Address can not be determined by the ECU during runtime. Therefore the Tester Address has to be fixed.</TUV>
</DESC>
<QUAL>Extended_11Bit.TesterAddress</QUAL>
</UNSDEF>
<ENUMDEF id='_0000000020CAC200' oid='612EDCEEB6D34f09BFB3B4619D341360' temploid='2A089233072C44c4AD5D5AAED307FFD0' attrcatref='_00000000053B63C0' usage='sys' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Functional Addressing Scheme</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Addressing Scheme used for functional requests.</TUV>
</DESC>
<QUAL>Extended_11Bit.AddrSchemeFunc</QUAL>
<ETAG v='1'>
<TUV xml:lang='en-US'>Extended</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020CAC3A0' oid='760F052329AC48669E1D95761836D17D' temploid='96880EBF8CB445539099FC21751ED2F1' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Functional CAN-ID Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>CAN-ID Type used for functional request</TUV>
</DESC>
<QUAL>Extended_11Bit.CanIdTypeFunc</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>11-Bit</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>29-Bit</TUV>
</ETAG>
</ENUMDEF>
<UNSDEF id='_0000000020CAD570' oid='A2606AF7A3474984BCC42503D1523771' temploid='E4994426BD9D4d0a9877FE43C70A0AE7' attrcatref='_00000000053B63C0' usage='sys' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Functional Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for functional requests.</TUV>
</DESC>
<QUAL>Extended_11Bit.ReqCanIdFunc</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAD720' oid='BF1516C525DE440aAEFB2374C2779839' temploid='1BF882EB504F43468715E8A3C2295210' attrcatref='_00000000053B63C0' usage='sys' v='2' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Broadcast Address</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Address of the functional group the ECU belongs to.</TUV>
</DESC>
<QUAL>Extended_11Bit.BroadcastAddress</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAD8D0' oid='1810ADCC3B524de485055AEE5E99CD22' temploid='85C84E1003D04a77AF4784D5D3D3F3A4' attrcatref='_00000000053B6A50' usage='sys' v='150' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Timeout for the client to wait after the successful transmission of a request message for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>Extended_11Bit.P2Client</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CADA80' oid='729D5A1E41FB45759DB96AFDCCAE4C05' temploid='CB88432501814c3dA7E44B6B5AFE4F3C' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the reception of a request message. In UDS this is the timeout for the default session.The tester will also require the P2Server timeout, since in UDS service "DiagnosticSessionControl"returns the P2Server and P2*Server timeouts – the tester has to calculate the offset manually and has to add it to the returned P2Server and P2*Server timeouts.</TUV>
</DESC>
<QUAL>Extended_11Bit.P2Server</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CADC30' oid='2B49F76477BB47e59E935EFF5DD85320' temploid='465590ECB1DF4a8f8D75B95B5BF2F268' attrcatref='_00000000053B6A50' usage='sys' v='2000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2*Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enhanced timeout for the client to wait after the reception of a negative response message with response code 78 hex for the start of incoming response messages. In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>Extended_11Bit.P2ExClient</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CADDE0' oid='C18299ABA5DD4236BDB7D26039F83407' temploid='3DA47C9989564f14B94EC2D814D51DA6' attrcatref='_00000000053B6A50' usage='sys' v='1950' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P2*Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Performance requirement for the server to start with the response message after the transmission of a negative response message with response code 78 hex (enhanced response timing). In UDS this is the timeout for the default session.</TUV>
</DESC>
<QUAL>Extended_11Bit.P2ExServer</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAE3D0' oid='96ECDA9FB759453294E80859BEB9A1D8' temploid='BAF2C833A8164b2d839FC206D330822A' attrcatref='_00000000053B6A50' usage='sys' v='4000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Client</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time between functionally addressed Tester Present request messages transmitted by the client to keep a diagnostic session other than the defaultSession active in multiple servers (functional communication) or maximum time between physically transmitted request messages to a single server (physical communication).</TUV>
</DESC>
<QUAL>Extended_11Bit.S3Client</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAE580' oid='A17428C5CAD84737AC6AF78625410163' temploid='549E9C0BDDBE4aafB679642E2A08BF42' attrcatref='_00000000053B6A50' usage='sys' v='5000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>S3Server</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for the server to keep a diagnostic session other than the defaultSession active while not receiving any diagnostic request message</TUV>
</DESC>
<QUAL>Extended_11Bit.S3Server</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAE730' oid='D3964BAB63C54c34A762ED47A4F5D6B2' temploid='89AB187C0F38420fAA483AF84EAFB9F6' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a physically addressed request message (indicated via N_USData.con) with no response required before it can transmit the next physically addressed request message.
Minimum value = P2Server</TUV>
</DESC>
<QUAL>Extended_11Bit.P3ClientPhys</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAE8E0' oid='D9659B38FB344ffeA5BCC11E224CC40C' temploid='3A0DC1DB7F9B4dbc915139823B38DB41' attrcatref='_00000000053B63C0' usage='sys' v='15872' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterPresentPhys</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the TesterPresent message for physically addressed requests used to keep a diagnostic session active.</TUV>
</DESC>
<QUAL>Extended_11Bit.TesterPresentPhys</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAEA90' oid='E5A52EBC9BBB42f4B8FF52158C1F0394' temploid='18C12767A68240f0947377473B7CDD80' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>P3ClientFunc</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Minimum time for the client to wait after the successful transmission of a functionally addressed request message (indicated via N_USData.con) before it can transmit the next functionally addressed request message in case no response is required or the requested data is only supported by a subset of the functionally addressed servers.
Minimum value = P2Server.</TUV>
</DESC>
<QUAL>Extended_11Bit.P3ClientFunc</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAEC40' oid='82CFC0AF7CFC4ced8C2CA95E89D997BC' temploid='6D9F28BABC644899A721C0FF0C2DA7AE' attrcatref='_00000000053B63C0' usage='sys' v='16000' df='hex'>
<NAME>
<TUV xml:lang='en-US'>TesterPresentFunc</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Defines the TesterPresent message for functionally addressed requests used to keep a diagnostic session active.</TUV>
</DESC>
<QUAL>Extended_11Bit.TesterPresentFunc</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAEDF0' oid='B2ACFCEC41874dd095DF06970D78944F' temploid='55BAA80B7A2C4024AB1C6DDA0E54AF3F' attrcatref='_00000000053B6A50' usage='sys' v='20' df='dec'>
<NAME>
<TUV xml:lang='en-US'>STmin</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>(Separation Time) defines the minimum time gap between consecutive frames.Values from 0x00 to 0x7F (0 – 127) are absolute milliseconds.Values from 0xF1 to 0xF9 are even 100 micro seconds.Every other value range is reserved and should not be used.</TUV>
</DESC>
<QUAL>Extended_11Bit.StMin</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAEFA0' oid='99D63276CC984a3585FBB24D472106E2' temploid='E80446BF6B1B4cb48F694FF3C05A1C85' attrcatref='_00000000053B63C0' usage='sys' v='0' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Blocksize</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The Blocksize parameter indicates, how many consecutive frames shall be sent in a transmission before a flow control frame is sent. The number 0 tells the sender, that no more flow controls should disrupt the sending of the remaining flow controls</TUV>
</DESC>
<QUAL>Extended_11Bit.Blocksize</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CAF150' oid='72F2D95F0B984c879B96894ECCC0053C' temploid='09560675EE584fba882466C1488F6209' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout As</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, sender side</TUV>
</DESC>
<QUAL>Extended_11Bit.TimeoutAs</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CBE7D0' oid='97A20FB7DC4046faAE0FD8B43216BC6B' temploid='9BBFEB22BD224cec8D807307BB40D12F' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Ar</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for transmission of frame, receiver side</TUV>
</DESC>
<QUAL>Extended_11Bit.TimeoutAr</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CBE980' oid='80409C83F0684e66A06A92D13F84DA8A' temploid='C806E0AF995046a282B583046F07F0C0' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Bs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control</TUV>
</DESC>
<QUAL>Extended_11Bit.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CBEB30' oid='E3AB070E660C4122AE66AB255EC074AF' temploid='12B8BBE7405B4b0284E9D114C38E113E' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Time Br</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for next transmission of flow control</TUV>
</DESC>
<QUAL>Extended_11Bit.TimeBr</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CBECE0' oid='5DEE6AD2D8734c92BD63A2EFF316DB5E' temploid='DEDD91DF8F1E486d848C53E222DE1D2D' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Time Cs</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until next transmission of consecutive frame</TUV>
</DESC>
<QUAL>Extended_11Bit.TimeCs</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CBEE90' oid='5A17B00BAF2A4d00AF1AFA1074E0224C' temploid='AAEFCAF382D94075A24BCCDC0C533F52' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Timeout Cr</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next consecutive frame</TUV>
</DESC>
<QUAL>Extended_11Bit.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CBF040' oid='F5C7EDB02F224cf7A87C23BB7AFF52B5' temploid='3ABFC6FA77394f7cA637AB842CD2F8A2' attrcatref='_00000000053B63C0' usage='sys' v='4095' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Max Length of TP Message</TUV>
</NAME>
<QUAL>Extended_11Bit.MaxLengthTpMessage</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CBF1F0' oid='DFC10231609543088F5339B845520520' temploid='273E286729F647569CDB4FE2AC4E603E' attrcatref='_00000000053B63C0' usage='sys' v='500000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bus Speed of the used transport media. Caution, the Bus Speed has to be set identical in all ECUs connected to one subnet.</TUV>
</DESC>
<QUAL>Extended_11Bit.Baudrate</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CBF3A0' oid='D9A2450ED95145eb9B8B69AD708E22A1' temploid='9C2C53174AB94e2e92F1CA5B55F02337' attrcatref='_00000000053B63C0' usage='sys' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>CANFrameFillerByte</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Fill byte used for filling CAN frames to eight byte length.</TUV>
</DESC>
<QUAL>Extended_11Bit.CANFrameFillerByte</QUAL>
</UNSDEF>
<ENUMDEF id='_0000000020CAC540' oid='48CE919915DE4aba8B9FA4B54F3753DA' temploid='72D958CC28A945bc81A325E99256574A' attrcatref='_00000000053B63C0' usage='sys' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FillerByteHandling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enables use of fill bytes; if "true", fill bytes are used, otherwise DLC may be smaller than 8.</TUV>
</DESC>
<QUAL>Extended_11Bit.FillerByteHandling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>false</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>true</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020CAC6E0' oid='7F8E192073504778A475BE136B23072C' temploid='5F74F65EFA594c0fB2B4510188BF4DAB' attrcatref='_00000000053B6660' usage='sys' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Extended 29Bit</TUV>
</NAME>
<QUAL>Extended_29Bit</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>not supported</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>supported</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020CAC880' oid='5A1911778A3F42efB4CC34D93164E1A5' temploid='8F70300B4CD04c20BB9146B636AEA14A' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Bus Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of transport media</TUV>
</DESC>
<QUAL>Extended_29Bit.BusType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>CAN</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020CACA20' oid='328BA0B123014ed49519CD6C729C0253' temploid='65C661F335344135A9231BD4C52B4F2F' attrcatref='_00000000053B63C0' usage='sys' v='0' sort='id'>
<NAME>
<TUV xml:lang='en-US'>Transport Protocol Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Type of used Transport Protocol (e.g. ISO15765)</TUV>
</DESC>
<QUAL>Extended_29Bit.TransportProtocolType</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>ISO15765</TUV>
</ETAG>
</ENUMDEF>
