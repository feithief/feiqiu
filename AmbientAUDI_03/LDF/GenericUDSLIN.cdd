<NAME>
<TUV xml:lang='en-US'>Timing Parameter Access Type</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The sub-function parameter timingParameterAccessType is used by the AccessTimingParameter service to select the specific behavior of the server.</TUV>
</DESC>
<QUAL>timingParameterAccessType</QUAL>
</DATAOBJ>
</SIMPLECOMPCONT>
<SIMPLECOMPCONT oid='F89BF52F27E842d492366D14257B4EC7' temploid='3CB56EAF3FCC4af1955416A5014D31F3' shproxyref='_0000000020E8B900'>
