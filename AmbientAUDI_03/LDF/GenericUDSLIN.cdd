</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for next transmission of flow control</TUV>
</DESC>
<QUAL>Normal_11Bit.TimeBr</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C87E80' oid='74AE525623144bf58351E2D5A04910BD' temploid='4F75C4192154487eBEE7B8926A038CB4' attrcatref='_00000000053B6A50' usage='sys' v='100' df='dec'>
