</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next consecutive frame</TUV>
</DESC>
<QUAL>Normal_11Bit.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C881E0' oid='54106F6269A545d2A04A5975A7E4DA13' temploid='ACA473F1745F4ecc94B0221F66079A57' attrcatref='_00000000053B63C0' usage='sys' v='4095' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Max Length of TP Message</TUV>
</NAME>
<QUAL>Normal_11Bit.MaxLengthTpMessage</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C8D860' oid='A1B6348605A4405bA0B440027C943DB3' temploid='B8F273F117F643e8AC3906E1B8E01899' attrcatref='_00000000053B63C0' usage='sys' v='500000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bus Speed of the used transport media. Caution, the Bus Speed has to be set identical in all ECUs connected to one subnet.</TUV>
</DESC>
<QUAL>Normal_11Bit.Baudrate</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020C8DA10' oid='63960B2DABF84087A4BB132ADF0C0597' temploid='A821A689155F4c7c9C49DCCBE1BAA91F' attrcatref='_00000000053B63C0' usage='sys' v='0' df='hex'>
