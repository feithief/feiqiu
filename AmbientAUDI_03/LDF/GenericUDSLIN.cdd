<NAME>
<TUV xml:lang='en-US'>($83) AccessTimingParameter</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC>The AccessTimingParameter service is used to read and change the default timing parameters of a communication link for the duration this communication link is active.</FC>
</PARA>
</TUV>
</DESC>
<QUAL>AccessTimingParameter</QUAL>
<SERVICE id='_0000000020EE7ED0' oid='7F6C8B18C10F4b029D4FFAFB6D16476B' temploid='7377FAE6B11B45d0B027C3BB75FBBB18' tmplref='_0000000020E89B10' func='0' phys='1' respOnPhys='1' respOnFunc='0' req='0'>
