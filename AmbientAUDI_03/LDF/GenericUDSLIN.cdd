</NAME>
<QUAL>Normal_29Bit.MaxLengthTpMessage</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CA7280' oid='393E37952E1443df830BD8A96BFB5FE6' temploid='E2201883D3694aa5B8DEDF0DA3F8AC72' attrcatref='_00000000053B63C0' usage='sys' v='500000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bus Speed of the used transport media. Caution, the Bus Speed has to be set identical in all ECUs connected to one subnet.</TUV>
</DESC>
<QUAL>Normal_29Bit.Baudrate</QUAL>
</UNSDEF>
<UNSDEF id='_0000000020CA7430' oid='81DBFE53740F481b8006C244648CA24E' temploid='FAD5A986059B4b349364AB48C6E10921' attrcatref='_00000000053B63C0' usage='sys' v='0' df='hex'>
<NAME>
<TUV xml:lang='en-US'>CANFrameFillerByte</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Fill byte used for filling CAN frames to eight byte length.</TUV>
</DESC>
<QUAL>Normal_29Bit.CANFrameFillerByte</QUAL>
</UNSDEF>
<ENUMDEF id='_0000000020C90EE0' oid='31FAE4E02D924ceeA35FFE960A2AE4C7' temploid='F9E513C234F2481fBBE5274ED78907B6' attrcatref='_00000000053B63C0' usage='sys' v='1' sort='id'>
<NAME>
<TUV xml:lang='en-US'>FillerByteHandling</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Enables use of fill bytes; if "true", fill bytes are used, otherwise DLC may be smaller than 8.</TUV>
</DESC>
<QUAL>Normal_29Bit.FillerByteHandling</QUAL>
<ETAG v='0'>
<TUV xml:lang='en-US'>false</TUV>
</ETAG>
<ETAG v='1'>
<TUV xml:lang='en-US'>true</TUV>
</ETAG>
</ENUMDEF>
<ENUMDEF id='_0000000020C91080' oid='CFCF662562C3493096F92B25C7177869' temploid='5FC6F7B7D2E242d98CA46D2B80B1F69D' attrcatref='_00000000053B6660' usage='sys' v='1' sort='id'>
<NAME>
