</NAME>
<DESC>
<TUV xml:lang='en-US' struct='1'><PARA><FC>The requestDownload service is used by the client to initiate a data transfer from the client to the server (download).</FC>
</PARA>
</TUV>
</DESC>
<QUAL>RequestDownload</QUAL>
<SERVICE id='_0000000020EE70F0' oid='475E1011085240f785E3FC9290D59A10' temploid='F2CF129BC00445fcAD9D6CE800A46257' tmplref='_0000000020E64EF0' func='0' phys='1' respOnPhys='1' respOnFunc='0' req='1'>
