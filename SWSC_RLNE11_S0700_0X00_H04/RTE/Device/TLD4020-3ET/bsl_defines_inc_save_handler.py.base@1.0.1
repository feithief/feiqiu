def bsl_defines_inc_save_handler():

    with open('bsl_defines_ARM.inc', 'w+') as file:
        file.write('BSL_FTO_NAD_NAC         EQU     ' + hex(int(BSL_FTO_NAD_NAC_REG_variable.text.replace('\u202c', ''))).upper().replace('X', 'x') + '\n')
        file.write('BSL_UCODE_UBSL_SIZE     EQU     ' + hex(int(BSL_UCODE_UBSL_SIZE_REG_variable.text.replace('\u202c', ''))).upper().replace('X', 'x') + '\n')
        file.write('                        END\n')
    with open('bsl_defines_IAR.inc', 'w+') as file:
        file.write('BSL_FTO_NAD_NAC         EQU     ' + hex(int(BSL_FTO_NAD_NAC_REG_variable.text.replace('\u202c', ''))).upper().replace('X', 'x') + '\n')
        file.write('BSL_UCODE_UBSL_SIZE     EQU     ' + hex(int(BSL_UCODE_UBSL_SIZE_REG_variable.text.replace('\u202c', ''))).upper().replace('X', 'x') + '\n')
    
  

FILE_SAVE.connect('triggered()', bsl_defines_inc_save_handler)