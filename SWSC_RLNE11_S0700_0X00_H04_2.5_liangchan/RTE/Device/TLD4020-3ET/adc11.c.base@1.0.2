#include "adc11.h"

/*******************************************************************************
**                        Private Variable Declarations                       **
*******************************************************************************/
static uint8 HV_PCSW_GAIN;
static sint8 HV_PCSW_OFFS;
static uint8 HVFWD_PCSW_GAIN;
static sint8 HVFWD_PCSW_OFFS;
static uint8 MV_PCSW_GAIN;
static sint8 MV_PCSW_OFFS;
static uint8 LVAA_PCSW_GAIN;
static sint8 LVAA_PCSW_OFFS;
static uint8 LVDTS_PCSW_GAIN;
static sint8 LVDTS_PCSW_OFFS;
static uint8 LVDTS_PCSW_CHK;

/*******************************************************************************
**                         Global Function Definitions                        **
*******************************************************************************/

/** \brief Initialize the ADC11 module
 * 
 * \return sint8 0: success, <0: error codes
 */
sint8 ADC11_init(void)
{
  /*{44210B09-2F0D-42e0-83E3-9C71632BEE6A}*/

  sint8 s8_returnCode;
  uint8 *u8p_hv_pcsw_gain;
  sint8 *s8p_hv_pcsw_offs;
  uint8 *u8p_hvfwd_pcsw_gain;
  sint8 *s8p_hvfwd_pcsw_offs;
  uint8 *u8p_mv_pcsw_gain;
  sint8 *s8p_mv_pcsw_offs;
  uint8 *u8p_lvaa_pcsw_gain;
  sint8 *s8p_lvaa_pcsw_offs;
  uint8 *u8p_lvdts_pcsw_gain;
  sint8 *s8p_lvdts_pcsw_offs;
  uint8 *u8p_lvaa_pcsw_chk;
	
  s8_returnCode = ERR_LOG_CODE_MODULE_DISABLED_IN_CW;

  #if ((ADC11_CFG_1 & ADC11_CFG_1_ADC_ENABLE_Msk) == ADC11_CFG_1_ADC_ENABLE_Msk)
    s8_returnCode = ERR_LOG_SUCCESS;
  
    ADC11->CFG_0.reg = (uint32) ADC11_CFG_0;
    ADC11->IEN.reg = (uint32) ADC11_IEN;
    ADC11->CFG_1.reg = (uint32) ADC11_CFG_1;

  #endif

  /* Fetch post calibration gain and offset values from flash */
  u8p_hv_pcsw_gain = (uint8 *)(ADC_CAL0_ADDR);        /* Get address of post calibration Gain of ADC ch0, VS */
  s8p_hv_pcsw_offs = (sint8 *)(ADC_CAL1_ADDR);        /* Get address of post calibration Offset of ADC ch0, VS */
  u8p_hvfwd_pcsw_gain = (uint8 *)(ADC_CAL2_ADDR);     /* Get address of post calibration Gain of ADC ch1/ch2/ch3, V_forward LEDx */
  s8p_hvfwd_pcsw_offs = (sint8 *)(ADC_CAL3_ADDR);     /* Get address of post calibration Offset of ADC ch1/ch2/ch3, V_forward LEDx */
  u8p_mv_pcsw_gain = (uint8 *)(ADC_CAL4_ADDR);        /* Get address of post calibration Gain of ADC ch4/ch5/ch6, GPIOx and TMS */
  s8p_mv_pcsw_offs = (sint8 *)(ADC_CAL5_ADDR);        /* Get address of post calibration Offset of ADC ch4/ch5/ch6, GPIOx and TMS */
  u8p_lvaa_pcsw_gain = (uint8 *)(ADC_CAL6_ADDR);      /* Get address of post calibration Gain of ADC ch7/ch8, diff for LIN AutoAddressing chx */
  s8p_lvaa_pcsw_offs = (sint8 *)(ADC_CAL7_ADDR);      /* Get address of post calibration Offset of ADC ch7/ch8, diff for LIN AutoAddressing chx */
  u8p_lvdts_pcsw_gain = (uint8 *)(ADC_CAL8_ADDR);     /* Get address of post calibration Gain of ADC ch9, Temperature sensor */
  s8p_lvdts_pcsw_offs = (sint8 *)(ADC_CAL9_ADDR);     /* Get address of post calibration Offset of ADC ch9, Temperature sensor */	
  u8p_lvaa_pcsw_chk = (uint8 *)(ADC_CAL6_7_CHK_ADDR); /* Get address of post calibration guard, diff for LIN AutoAddressing chk */
  
  HV_PCSW_GAIN    = *u8p_hv_pcsw_gain;     /* Get value of post calibration Gain of ADC ch0, VS */
  HV_PCSW_OFFS    = *s8p_hv_pcsw_offs;     /* Get value of post calibration Offset of ADC ch0, VS */
  HVFWD_PCSW_GAIN = *u8p_hvfwd_pcsw_gain;  /* Get value of post calibration Gain of ADC ch1/ch2/ch3, V_forward LEDx */
  HVFWD_PCSW_OFFS = *s8p_hvfwd_pcsw_offs;  /* Get value of post calibration Offset of ADC ch1/ch2/ch3, V_forward LEDx */
  MV_PCSW_GAIN    = *u8p_mv_pcsw_gain;     /* Get value of post calibration Gain of ADC ch4/ch5/ch6, GPIOx and TMS */
  MV_PCSW_OFFS    = *s8p_mv_pcsw_offs;     /* Get value of post calibration Offset of ADC ch4/ch5/ch6, GPIOx and TMS */
  LVAA_PCSW_GAIN  = *u8p_lvaa_pcsw_gain;   /* Get value of post calibration Gain of ADC ch7/ch8, diff for LIN AutoAddressing chx */
  LVAA_PCSW_OFFS  = *s8p_lvaa_pcsw_offs;   /* Get value of post calibration Offset of ADC ch7/ch8, diff for LIN AutoAddressing chx */
  LVDTS_PCSW_GAIN = *u8p_lvdts_pcsw_gain;  /* Get value of post calibration Gain of ADC ch9, Temperature sensor */
  LVDTS_PCSW_OFFS = *s8p_lvdts_pcsw_offs;  /* Get value of post calibration Offset of ADC ch9, Temperature sensor */
  LVDTS_PCSW_CHK  = *u8p_lvaa_pcsw_chk;    /* Get value of post calibration guard, diff for LIN AutoAddressing check */
	
  return s8_returnCode;	
}

/** \brief Compensate ADC11 reading with gain and offset stored in Flash, in order to have
 *         a more precise result on the LIN shunt current reading
 *         Evaluation of gain and offset is done by Infineon
 *         Gain and offset are available for the difference between the two ADC channels
 *         (ch7 and ch8) for LIN Auto Addressing 
 * \param  s16_adcValue Value to be compensated
 * \return sint16 Compensated value
 *
 * \brief <b>Example</b><br>
 * \brief This example compensates the accumulated ADC results of Auto Addressing phase
 *        measure loop
 * ~~~~~~~~~~~~~~~{.c}
 * sint16 s16_var;
 * sint16 s16_var_comp;
 *
 * s16_var = ((sint16)LIN->AA_ACC_RES_1.bit.ACC_RES_1 - (sint16)LIN->AA_ACC_RES_2.bit.ACC_RES_2) >> LIN->AA_CTRL.bit.ISENSE_MEAS_NUMBER;
 * s16_var_comp = ADC11_compensateLinAutoAddrDiff(s16_var);
 * ~~~~~~~~~~~~~~~
 */
sint16 ADC11_compensateLinAutoAddrDiff(sint16 s16_adcValue)
{
  sint32 s32_temp;
  
  if (LVAA_PCSW_GAIN != 0 && ((LVDTS_PCSW_CHK & 0x80) != 0))
  {
    /* gain compensation and adapt to offset representation */
    s32_temp = ((sint32)s16_adcValue * LVAA_PCSW_GAIN) >> 6;
    /* offset compensation */
    s32_temp += (sint32)LVAA_PCSW_OFFS;
    /* remove fractional part */
    s32_temp = s32_temp >> 1;                      
  }
	else
	{
    /* device not trimmed - skip procedure */
    s32_temp = s16_adcValue;
  }
  
  return (sint16)s32_temp;
}

