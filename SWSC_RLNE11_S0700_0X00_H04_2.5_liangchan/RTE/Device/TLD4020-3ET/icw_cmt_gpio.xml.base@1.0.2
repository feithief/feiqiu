<ifxmlcfg version="2.6.2">
	<checksum>5b933b3ba97d65eeaa82b68d4002b7612877e2aafa196953cf09780a5af042f3</checksum>
  <version label="V1.0.2"/>


  <verticalcontainer label="GPIO" desc="General-purpose input/output">
    <treecontainer headerlabels="Item;Value;" label="GPIO" desc="" columnwidths="400;250">
        <header file="gpio_defines.h">
                
            <branch label="Pin0" expand="0">

                <radio label="" define="GPIO.PDISC.PDIS0">

                    <radiobutton label="Digital input/output" uielement="branch">

                        <radio label="" define="GPIO.PADCFG0_DRVCFG.DIR">
                                                
                            <radiobutton label="Input" uielement="branch"/>
                            
                            <radiobutton label="Output" uielement="branch">
                                
                                <combo label="Data" define="GPIO.PADCFG0_GPIO.OUT"/>
                            							
                            </radiobutton>
							
							<combo label="Mode" define="GPIO.PADCFG0_DRVCFG.MODE" default="label=Output: clkout, Input: Pull-down"/>

                            <checkbox label="Interrupt" define="GPIO_IEN0_INT_EN" uielement="branch" expand="0" default="0" svd="0" header="isr_defines.h">
						    
                                <checkbox label="Enable interrupt" define="GPIO.IEN.IEN0"/>
                                <edit label="Callback" define="GPIO_IEN0_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>
						    
                            </checkbox>
						
						</radio>

                    </radiobutton>

                    <radiobutton label="Analog input" />

                </radio>
                
            </branch>

            <branch label="Pin1" expand="0">

                <radio label="" define="GPIO.PDISC.PDIS1">

                    <radiobutton label="Digital input/output" uielement="branch">

                        <radio label="" define="GPIO.PADCFG1_DRVCFG.DIR">
                                                
                            <radiobutton label="Input" uielement="branch"/>
                            
                            <radiobutton label="Output" uielement="branch">
                                
                                <combo label="Data" define="GPIO.PADCFG1_GPIO.OUT"/>
                            
                            </radiobutton>
							
							<combo label="Mode" define="GPIO.PADCFG1_DRVCFG.MODE" default="label=Output: No alt function, Input: Pull-down"/>
                            
							<checkbox label="Interrupt" define="GPIO_IEN1_INT_EN" uielement="branch" expand="0" default="0" svd="0" header="isr_defines.h">

                                <checkbox label="Enable interrupt" define="GPIO.IEN.IEN1"/>
                                <edit label="Callback" define="GPIO_IEN1_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

                            </checkbox>
						
                        </radio>

                    </radiobutton>

                    <radiobutton label="Analog input"/>

                </radio>
  
            </branch>

        </header>
    </treecontainer>

  </verticalcontainer>


</ifxmlcfg>
