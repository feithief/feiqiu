install_target: first FORCE
	@test -d $(INSTALL_ROOT)/root/ControlBox/test || mkdir -p $(INSTALL_ROOT)/root/ControlBox/test
	-$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/root/ControlBox/test/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/root/ControlBox/test/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/root/ControlBox/test/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

