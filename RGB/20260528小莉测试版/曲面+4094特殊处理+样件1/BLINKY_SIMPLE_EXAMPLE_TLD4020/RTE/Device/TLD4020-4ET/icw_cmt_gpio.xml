<ifxmlcfg version="2.6.2">
	<checksum>2c3d01f4c6d5d9878748b57fc658b21a83ed0ae651a4554816c12e8601491dfe</checksum>
  <version label="V2.2.0"/>


  <verticalcontainer label="GPIO" desc="General-purpose input/output">
    <treecontainer headerlabels="Item;Value;" label="GPIO" desc="" columnwidths="400;250">
        <header file="gpio_defines.h">
                
            <branch label="Pin0" expand="0">
                <radio label="" define="GPIO.PDISC.PDIS0">
                    <radiobutton label="Digital input/output" uielement="branch">
                        <radio label="" define="GPIO.PADCFG0_DRVCFG.DIR">                                               
                            <radiobutton label="Input" uielement="branch"/>                            
                            <radiobutton label="Output" uielement="branch">                                
                                <combo label="Data" define="GPIO.OUT.P0"/>
                                <combo label="Output Buffer configuration" define="GPIO.PADCFG0_DRVCFG.OD" startcond="UC_FEATURE_GPIOOUTBUF==1"/>                           							
                            </radiobutton>							
							<combo label="Mode" define="GPIO.PADCFG0_DRVCFG.MODE" default="label=Output: Clkout, Input: Pull-down"/>
                            <checkbox label="Interrupt" define="GPIO_IEN0_INT_EN" uielement="branch" expand="0" default="0" svd="0" header="isr_defines.h" lockon="CPU.NVIC_ISER0.SETENA[7]=1">						    
                                <checkbox label="Enable interrupt" define="GPIO.IEN.IEN0"/>
                                <edit label="Callback" define="GPIO_IEN0_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>						    
                            </checkbox>
						</radio>
                    </radiobutton>
                    <radiobutton label="Analog input"/>
                </radio>             
            </branch>

            <branch label="Pin1" expand="0">
                <radio label="" define="GPIO.PDISC.PDIS1">
                    <radiobutton label="Digital input/output" uielement="branch">
                        <radio label="" define="GPIO.PADCFG1_DRVCFG.DIR">               
                            <radiobutton label="Input" uielement="branch"/>
                            <radiobutton label="Output" uielement="branch">   
                                <combo label="Data" define="GPIO.OUT.P1"/>
                                <combo label="Output Buffer configuration" define="GPIO.PADCFG1_DRVCFG.OD" startcond="UC_FEATURE_GPIOOUTBUF==1"/>
                            </radiobutton>
							<combo label="Mode" define="GPIO.PADCFG1_DRVCFG.MODE" default="label=Output: UART_TX, Input: Pull-down"/>
							<checkbox label="Interrupt" define="GPIO_IEN1_INT_EN" uielement="branch" expand="0" default="0" svd="0" header="isr_defines.h" lockon="CPU.NVIC_ISER0.SETENA[7]=1">
                                <checkbox label="Enable interrupt" define="GPIO.IEN.IEN1"/>
                                <edit label="Callback" define="GPIO_IEN1_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>
                            </checkbox>
                        </radio>
                    </radiobutton>
                    <radiobutton label="Analog input"/>
                </radio>
            </branch>
            
            <branch startcond="UC_FEATURE_12CHANNEL==1" label="Pin3" expand="0">
                <radio label="" define="GPIO.PDISC.PDIS3">
                    <radiobutton label="Digital input/output" uielement="branch">
                        <radio label="" define="GPIO.PADCFG3_DRVCFG.DIR">               
                            <radiobutton label="Input" uielement="branch"/>
                            <radiobutton label="Output" uielement="branch">   
                                <combo label="Data" define="GPIO.OUT.P3"/>
                                <combo label="Output Buffer configuration" define="GPIO.PADCFG3_DRVCFG.OD" startcond="UC_FEATURE_GPIOOUTBUF==1"/>
                            </radiobutton>
							<combo label="Mode" define="GPIO.PADCFG3_DRVCFG.MODE" default="0"/>
							<checkbox label="Interrupt" define="GPIO_IEN3_INT_EN" uielement="branch" expand="0" default="0" svd="0" header="isr_defines.h" lockon="CPU.NVIC_ISER0.SETENA[7]=1">
                                <checkbox label="Enable interrupt" define="GPIO.IEN.IEN3"/>
                                <edit label="Callback" define="GPIO_IEN3_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>
                            </checkbox>
                        </radio>
                    </radiobutton>
                    <radiobutton label="Analog input"/>
                </radio>
            </branch>
            
            <branch startcond="UC_FEATURE_12CHANNEL==1" label="Pin4" expand="0">
                <radio label="" define="GPIO.PDISC.PDIS4">
                    <radiobutton label="Digital input/output" uielement="branch">
                        <radio label="" define="GPIO.PADCFG4_DRVCFG.DIR">               
                            <radiobutton label="Input" uielement="branch"/>
                            <radiobutton label="Output" uielement="branch">   
                                <combo label="Data" define="GPIO.OUT.P4"/>
                                <combo label="Output Buffer configuration" define="GPIO.PADCFG4_DRVCFG.OD" startcond="UC_FEATURE_GPIOOUTBUF==1"/>
                            </radiobutton>
							<combo label="Mode" define="GPIO.PADCFG4_DRVCFG.MODE" default="0"/>
							<checkbox label="Interrupt" define="GPIO_IEN4_INT_EN" uielement="branch" expand="0" default="0" svd="0" header="isr_defines.h" lockon="CPU.NVIC_ISER0.SETENA[7]=1">
                                <checkbox label="Enable interrupt" define="GPIO.IEN.IEN4"/>
                                <edit label="Callback" define="GPIO_IEN4_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>
                            </checkbox>
                        </radio>
                    </radiobutton>
                    <radiobutton label="Analog input"/>
                </radio>
            </branch>

        </header>
    </treecontainer>
  </verticalcontainer>
</ifxmlcfg>
