  <version label="V1.2.0"/>
  <unsignedsuffix value="1"/>
  
  <!-- UC_FEATURE_* defines for usage in startcond -->
  <!-- by default everything set to 0, set to 1 on demand -->
  <setdefine value="0" define="UC_FEATURE_4CHANNEL"/>
  <setdefine value="0" define="UC_FEATURE_12CHANNEL"/>
  <setdefine value="0" define="UC_FEATURE_GPIOOUTBUF"/>
  <setdefine value="0" define="UC_FEATURE_5GPIO"/>
  <setdefine value="0" define="UC_FEATURE_UART2"/>
  
  <!-- TLD4020_3ET -->
  <!-- No specific features for device==TLD4020-3ET -->
  <!-- TLD4020_4ET -->
  <setdefine value="1" startcond="device==TLD4020-4ET" define="UC_FEATURE_4CHANNEL"/>
  <setdefine value="1" startcond="device==TLD4020-4ET" define="UC_FEATURE_GPIOOUTBUF"/>
  <setdefine value="1" startcond="device==TLD4020-4ET" define="UC_FEATURE_UART2"/>
  <!-- TLD4030_12ES -->
  <setdefine value="1" startcond="device==TLD4030-12ES" define="UC_FEATURE_4CHANNEL"/>
  <setdefine value="1" startcond="device==TLD4030-12ES" define="UC_FEATURE_12CHANNEL"/>
  <setdefine value="1" startcond="device==TLD4030-12ES" define="UC_FEATURE_GPIOOUTBUF"/>
  <setdefine value="1" startcond="device==TLD4030-12ES" define="UC_FEATURE_5GPIO"/>
  <setdefine value="1" startcond="device==TLD4030-12ES" define="UC_FEATURE_UART2"/>
  
  <!-- svd file based on device -->
  <svd startcond="device==TLD4020-3ET" file="tld40xx.svd"/>
  <svd startcond="device==TLD4020-4ET" file="tld40xx_4et.svd"/>
  <svd startcond="device==TLD4030-12ES" file="tld40xx_12es.svd"/>

  <usesPython/>
  <pythonstartup file="ldrv.py" afterinit="1"/>

  <tabcontainer label="Peripherals">

    <!-- setdefine can be used in startcond, but not in cond -->
    <!-- To use them in cond, e.g. for an action, a math with exactly the same name and value is created -->
    <math visible="false" label="math for UC_FEATURE_4CHANNEL" define="UC_FEATURE_4CHANNEL" svd="0" formula="0" startcond="UC_FEATURE_4CHANNEL==0"/>
    <math visible="false" label="math for UC_FEATURE_4CHANNEL" define="UC_FEATURE_4CHANNEL" svd="0" formula="1" startcond="UC_FEATURE_4CHANNEL==1"/>
