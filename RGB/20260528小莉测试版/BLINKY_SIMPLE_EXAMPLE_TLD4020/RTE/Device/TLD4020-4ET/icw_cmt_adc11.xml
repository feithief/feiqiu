<ifxmlcfg version="2.6.2">
	<checksum>65f9ae503e2e4ddb736315d8878c0d78b66579c03504d25c2b4d221d992a7cfc</checksum>
  <version label="V1.0.4"/>


  <verticalcontainer label="ADC11" desc="Analog to Digital Converter">
    <treecontainer headerlabels="Item;Value;" label="ADC11" desc="" columnwidths="400;250">
        <header file="adc11_defines.h">
                
            <checkbox label="ADC11 enable" define="ADC11.CFG_1.ADC_ENABLE" uielement="branch" expand="0" default="0">

                <combo label="Sample time control" define="ADC11.CFG_0.ADC_STC"/>

                <combo label="Fullscale range for differential conversion (Vfwd LED)" define="ADC11.CFG_0.ADC_SEL_4V" default="label=4V fullscale selected"/>

                <combo label="Oversampling configuration" define="ADC11.CFG_0.ADC_OVERS_CFG"/>

                <checkbox label="Digital Temperature Sensor (DTS) overtemperature enable" define="ADC11.CFG_0.DTS_OVT_EN"/>

                <checkbox label="Fast comparator mode enable" define="ADC11.CFG_1.ADC_COMP_EN" uielement="branch" expand="0" default="0">
                    <!-- Possible values for ADC_COMP_VAL = 2^13 - 1 = 8191 -->
                    <spinbox label="Fast comparator mode digital threshold" define="ADC11.CFG_0.ADC_COMP_VAL" default="8" step="1" range="0;8191"/> 
			    
                </checkbox>
			    
                <branch startcond="UC_FEATURE_12CHANNEL==1" label="Power Off Load" expand="0">

                    <checkbox label="Channel 2 (VSL-OUT0) Enable" define="ADC11.PWROFFLD.bit.EN[0]"/>

                    <checkbox label="Channel 3 (VSL-OUT1) Enable" define="ADC11.PWROFFLD.bit.EN[1]"/>

                    <checkbox label="Channel 4 (VSL-OUT2) Enable" define="ADC11.PWROFFLD.bit.EN[2]"/>

                    <checkbox label="Channel 5 (VSL-OUT3) Enable" define="ADC11.PWROFFLD.bit.EN[3]"/>

                    <checkbox label="Channel 6 (VSL-OUT4) Enable" define="ADC11.PWROFFLD.bit.EN[4]"/>

                    <checkbox label="Channel 7 (VSL-OUT5) Enable" define="ADC11.PWROFFLD.bit.EN[5]"/>

                    <checkbox label="Channel 8 (VSL-OUT6) Enable" define="ADC11.PWROFFLD.bit.EN[6]"/>

                    <checkbox label="Channel 9 (VSL-OUT7) Enable" define="ADC11.PWROFFLD.bit.EN[7]"/>

                    <checkbox label="Channel 10 (VSL-OUT8) Enable" define="ADC11.PWROFFLD.bit.EN[8]"/>

                    <checkbox label="Channel 11 (VSL-OUT9) Enable" define="ADC11.PWROFFLD.bit.EN[9]"/>

                    <checkbox label="Channel 12 (VSL-OUT10) Enable" define="ADC11.PWROFFLD.bit.EN[10]"/>

                    <checkbox label="Channel 13 (VSL-OUT11) Enable" define="ADC11.PWROFFLD.bit.EN[11]"/>
                    
                    <combo label="Differential VFWD conversion reference" define="ADC11.PWROFFLD.bit.SRC[12]">
                        <item label="GPIO0" value="0"/>
                        <item label="OUT5" value="1"/>
                    </combo>
                
                </branch>


                <branch label="Interrupt Request Handling" expand="0">
			    
                    <checkbox label="Firmware End-Of-Conversion" define="ADC11_FW_EOC_INT_EN" uielement="branch" expand="0" default="0" svd="0" header="isr_defines.h" lockon="CPU.NVIC_ISER0.SETENA[4]=1">
			    
                        <checkbox label="Enable interrupt" define="ADC11.IEN.ADC_FW_EOC"/>
                        <edit label="Callback" define="ADC11_FW_EOC_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>
			    
                    </checkbox>
			    
                    <checkbox label="DTS overtemperature" define="ADC11_DTS_OVTEMP_INT_EN" uielement="branch" expand="0" default="0" svd="0" header="isr_defines.h" lockon="CPU.NVIC_ISER0.SETENA[4]=1">
			    
                        <checkbox label="Enable interrupt" define="ADC11.IEN.DTS_OVT"/>
                        <edit label="Callback" define="ADC11_DTS_OVTEMP_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>
			    
                    </checkbox>
			    </branch>
			</checkbox>
        </header>
    </treecontainer>
  </verticalcontainer>

</ifxmlcfg>
