<ifxmlcfg version="2.6.2">
	<checksum>f2dd37608f177829f22d8ef2ee3c2f7e17edbdddf44afbaae9914542c15bcc08</checksum>
  <version label="V1.0.4"/>


  <verticalcontainer label="PMU" desc="Power Management Unit">
    <treecontainer headerlabels="Item;Value;" label="PMU" desc="" columnwidths="400;250">
        <header file="pmu_defines.h">
                
            <checkbox label="VDD1V5 overvoltage" define="PMU_VDD1V5_OV_INT_EN" header="isr_defines.h" uielement="branch" expand="0" default="0" svd="0" lockon="CPU.NVIC_ISER0.SETENA[0]=1">

                <checkbox label="Enable interrupt" define="PMU.VDD1V5IEN.OV"/>
                <edit label="Callback" define="PMU_VDD1V5_OV_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

            </checkbox>

            <checkbox label="VDD1V5 NVM overvoltage monitor" define="PMU_VDD1V5NVM_OV_INT_EN" header="isr_defines.h" uielement="branch" expand="0" default="0" svd="0" lockon="CPU.NVIC_ISER0.SETENA[0]=1">

                <checkbox label="Enable interrupt" define="PMU.VDD1V5NVMIEN.OV"/>
                <edit label="Callback" define="PMU_VDD1V5NVM_OV_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

            </checkbox>

            <branch label="Wake-up control" expand="0">
                    
                <checkbox label="LIN wake-up enable" define="PMU.WAKECTRL.EXT0" default="1"/>

                <checkbox label="GPIO wake-up enable" define="PMU.WAKECTRL.IO0" uielement="branch" expand="0" default="1">

                    <combo label="Input selection" define="PMU.IOWAKECTRL0.INP"/>
                    <combo label="Filter time" define="PMU.WAKEFILTCTRL.IO"/>

                    <checkbox label="Rising edge detection enable" define="PMU.IOWAKECTRL0.RI" default="1"/>
                    <checkbox label="Falling edge detection enable" define="PMU.IOWAKECTRL0.FA" default="1"/>

                </checkbox>
                
            </branch>
            
            <branch label="Watchdog" expand="0">

                <checkbox label="Disable watchdog" define="PMU_WDCTRL_DISABLE" default="0" svd="0"/>

                <spinbox label="Watchdog Period [ms]" define="PMU.WDCTRL_WDP" svd="0" range="16;1008" step="1" default="1008" header="temp_defines.h"/>
                    <math visible="false" define="PMU.WDCTRL.WDP" formula="trunc(PMU.WDCTRL_WDP/16)"/>
                    <math label="Effective Watchdog Period [ms]" define="PMU.WDCTRL_WDP_EFFECTIVE" svd="0" formula="PMU.WDCTRL.WDP*16" header="temp_defines.h"/>
                    <math visible="false" label="Trigger Point" define="PMU.SAFE_TRIGGER" svd="0" formula="round(PMU.WDCTRL_WDP_EFFECTIVE*0.715)"/>

                <combo label="Short open window" define="PMU.WDCTRL.SOW"/>

            </branch>

        </header>
    </treecontainer>

  </verticalcontainer>

</ifxmlcfg>
