<ifxmlcfg version="2.6.2">
	<checksum>d0bf4389dee4b523b5f72cf7bd20b19b8a287b249119bb605001d6e6deffa348</checksum>
  <version label="V1.0.1"/>


  <verticalcontainer label="OSC" desc="Oscillator">
    <treecontainer headerlabels="Item;Value;" label="OSC" desc="" columnwidths="400;250">
        <header file="osc_defines.h">

            <math visible="true" label="ClkScr0" define="OSC_ClkScr0"  header="temp_defines.h" svd="0" formula="40" unit="MHz" />
            <!-- .* = AND -->
            <math visible="true" label="ClkScr1" define="OSC_ClkScr1"  header="temp_defines.h" svd="0" formula="((OSC.FCLKDIV.EN==1).*(OSC.FCLKDIV.PDIV&lt;OSC.FCLKDIV.QDIV))?(OSC.FCLKDIV.PDIV==0?OSC_ClkScr0:(OSC_ClkScr0 * OSC.FCLKDIV.PDIV / OSC.FCLKDIV.QDIV)):OSC_ClkScr0" unit="MHz" />
                
            <checkbox label="Oscillator divider enable" define="OSC.FCLKDIV.EN" uielement="branch" expand="0" default="0">
                    
                    <!-- Not working since event="selected" should be set to item, not combo -->
                    <!-- <combo label="PDIV" define="OSC.FCLKDIV.PDIV">
                        <action event="selected" cond="OSC.FCLKDIV.PDIV&lt;OSC.FCLKDIV.QDIV" cmd="setDef" data="OSC_PDIV_ERROR=0"/>
                        <action event="selected" cond="OSC.FCLKDIV.PDIV==OSC.FCLKDIV.QDIV" cmd="setDef" data="OSC_PDIV_ERROR=0"/>
                        <action event="selected" cond="OSC.FCLKDIV.PDIV&gt;OSC.FCLKDIV.QDIV" cmd="setDef" data="OSC_PDIV_ERROR=1"/>
                    </combo> -->
                    <combo label="PDIV" define="OSC.FCLKDIV.PDIV"/>

                    <combo label="QDIV" define="OSC.FCLKDIV.QDIV"/>

            </checkbox>

        </header>
    </treecontainer>

    <!-- Used to make appearing an error window box in case of inconsistency between PDIV and QDIV (0<=PDIV<=QDIV) -->
    <groupcontainer label="Consistency checking" visible="false">
        <verticalcontainer visible="false" label="PDIV QDIV error">
            <!-- combos needed to raise messagebox in case of clock error -->
            <combo label="OSC_PDIV_QDIV_ERROR" define="OSC_PDIV_QDIV_ERROR" header="temp_defines.h" svd="0">
                <item value="0" label="no error">
                </item>
                <item value="1" label="counter error">
                    <action event="selected" cmd="runScript" data="MessageBox(PDIV cannot be greater than QDIV.)"/>
                </item>
            </combo>
        </verticalcontainer>
    </groupcontainer>

    <!-- Used to make appearing an error window box in case of inconsistency between PDIV and QDIV (0<=PDIV<=QDIV). Cannot use traditional check on combo because "selected" event apply only for static item - not fectched from SVD-->
    <groupcontainer label="Timers" visible="false">
        <timer visible="false" define="OSC_PDIV_QDIV_CONSISTENCY" header="temp_defines.h" svd="0" interval="100" singleShot="0" run="1">
            <!-- <action event="changed" cond="OSC.FCLKDIV.PDIV&lt;OSC.FCLKDIV.QDIV .+ OSC.FCLKDIV.PDIV==OSC.FCLKDIV.QDIV" cmd="setDef" data="OSC_QDIV_ERROR=0"/> -->
            <action event="changed" cond="OSC.FCLKDIV.PDIV&lt;OSC.FCLKDIV.QDIV" cmd="setDef" data="OSC_PDIV_QDIV_ERROR=0"/>
            <action event="changed" cond="OSC.FCLKDIV.PDIV==OSC.FCLKDIV.QDIV" cmd="setDef" data="OSC_PDIV_QDIV_ERROR=0"/>
            <action event="changed" cond="OSC.FCLKDIV.PDIV&gt;OSC.FCLKDIV.QDIV" cmd="setDef" data="OSC_PDIV_QDIV_ERROR=1"/>
        </timer>
    </groupcontainer>

  </verticalcontainer>

</ifxmlcfg>
