<ifxmlcfg version="2.6.2">
	<checksum>a37fd1e403d586662322d13e442595e444b3160115b6fc1e17107fdea0227390</checksum>
  <version label="V1.1.6"/>

  <verticalcontainer label="SCU" desc="System Control Unit">
    <treecontainer headerlabels="Item;Value;" label="SCU" desc="System Control Unit" columnwidths="400;250">
        <header file="scu_defines.h">

            <!-- helper variables -->
            <var define="OSC_ClkScr0" svd="0" header="temp_defines.h" default="40"/>
			<var define="SCU_CPU_prescaler" svd="0" header="temp_defines.h" default="2"/>
			<var define="SCU_FILT_prescaler" svd="0" header="temp_defines.h" default="20"/>
			<!-- Show actual frequency values -->
            <math visible="true" label="f_SYS0" define="SCU_F_SYS0" header="temp_defines.h" svd="0" formula="OSC_ClkScr0" unit="MHz"/>
            <math visible="true" label="f_CPU" define="SCU_F_CPU" header="temp_defines.h" svd="0" formula="SCU_F_SYS0 / SCU_CPU_prescaler" unit="MHz"/>
            <math visible="true" label="f_FILT" define="SCU_F_FILT" header="temp_defines.h" svd="0" formula="SCU_F_SYS0 / SCU_FILT_prescaler" unit="MHz"/>
            <math visible="true" label="f_SYSTICK" define="SCU_F_SYSTICK" svd="0" formula="SCU_F_SYS0 / SCU_SYSTICK_divisor" unit="MHz"/>

            <branch label="Clock configuration" expand="0">

                <combo label="Filter clock prescaler" define="SCU.CLKCTRL.FILTDIV" default="label=clock divided by 20"/>

                <spinbox label="SYSTICK clock divisor" define="SCU_SYSTICK_divisor" header="temp_defines.h" svd="0" range="40;511" default="40"/>
                <math visible="true" label="SYSTICK clock divisor bitfield value" define="SCU.SYSTCKCTRL.SYSTCKDIV" formula="SCU_SYSTICK_divisor" format="%02X"/>

            </branch>

            <checkbox label="NVM clock ratio fail" define="SCU_NVMCLKRATIO_FAIL_INT_EN" header="isr_defines.h" uielement="branch" expand="0" default="0" svd="0">

                <checkbox label="Enable interrupt" define="SCU.NMIEN.NVMCLKRATIO"/>
                <edit label="Callback" define="SCU_NVMCLKRATIO_FAIL_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

            </checkbox>

        </header>
    </treecontainer>


    <!-- Timers used to set the prescaler. We cannot use "<action event="changed" cond="SCU.CLKCTRL.CPUDIV.index==1" cmd="setDef" data="SCU_CPU_prescaler=2"/>" because it does not work in case the <item> are fetched from svd-->
    <groupcontainer label="Consistency checking" visible="false">

        <timer visible="false" define="FILTER_clock_prescaler_CONSISTENCY" header="temp_defines.h" svd="0" interval="100" singleShot="0" run="1">

            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==0" cmd="setDef" data="SCU_FILT_prescaler=1"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==1" cmd="setDef" data="SCU_FILT_prescaler=2"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==2" cmd="setDef" data="SCU_FILT_prescaler=3"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==3" cmd="setDef" data="SCU_FILT_prescaler=4"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==4" cmd="setDef" data="SCU_FILT_prescaler=5"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==5" cmd="setDef" data="SCU_FILT_prescaler=6"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==6" cmd="setDef" data="SCU_FILT_prescaler=7"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==7" cmd="setDef" data="SCU_FILT_prescaler=8"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==8" cmd="setDef" data="SCU_FILT_prescaler=9"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==9" cmd="setDef" data="SCU_FILT_prescaler=10"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==10" cmd="setDef" data="SCU_FILT_prescaler=11"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==11" cmd="setDef" data="SCU_FILT_prescaler=12"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==12" cmd="setDef" data="SCU_FILT_prescaler=13"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==13" cmd="setDef" data="SCU_FILT_prescaler=14"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==14" cmd="setDef" data="SCU_FILT_prescaler=15"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==15" cmd="setDef" data="SCU_FILT_prescaler=16"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==16" cmd="setDef" data="SCU_FILT_prescaler=17"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==17" cmd="setDef" data="SCU_FILT_prescaler=18"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==18" cmd="setDef" data="SCU_FILT_prescaler=19"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==19" cmd="setDef" data="SCU_FILT_prescaler=20"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==20" cmd="setDef" data="SCU_FILT_prescaler=21"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==21" cmd="setDef" data="SCU_FILT_prescaler=22"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==22" cmd="setDef" data="SCU_FILT_prescaler=23"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==23" cmd="setDef" data="SCU_FILT_prescaler=24"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==24" cmd="setDef" data="SCU_FILT_prescaler=25"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==25" cmd="setDef" data="SCU_FILT_prescaler=26"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==26" cmd="setDef" data="SCU_FILT_prescaler=27"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==27" cmd="setDef" data="SCU_FILT_prescaler=28"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==28" cmd="setDef" data="SCU_FILT_prescaler=29"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==29" cmd="setDef" data="SCU_FILT_prescaler=30"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==30" cmd="setDef" data="SCU_FILT_prescaler=31"/>
            <action event="changed" cond="SCU.CLKCTRL.FILTDIV.index==31" cmd="setDef" data="SCU_FILT_prescaler=32"/>


        </timer>

    </groupcontainer>


  </verticalcontainer>

</ifxmlcfg>
