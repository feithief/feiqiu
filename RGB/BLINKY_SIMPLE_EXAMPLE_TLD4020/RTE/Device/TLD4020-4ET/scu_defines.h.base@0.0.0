#ifndef SCU_DEFINES_H
#define SCU_DEFINES_H

/* XML Version 1.1.6 */
#define SCU_XML_VERSION (10106)

#define SCU_CLKCTRL (0x1300u) /*decimal 4864*/

#define SCU_F_SYSTICK (0x1u) /*decimal 1*/

