<ifxmlcfg version="2.6.2">
  <checksum>5e67328739605ae3b4f2d093b27da6e18ac528de80b30a60209b04b94b646eef</checksum>
  <version label="V2.1.1"/>
  <svd file="tld40xx.svd"/>
  <!-- <usesPython/> -->

  <verticalcontainer label="LIN" desc="Local Interconnect Network transceiver">
    <treecontainer headerlabels="Item;Value;" label="LIN" desc="Local Interconnect Network" columnwidths="400;250">
      <header file="lin_defines.h">

        <checkbox label="Configure Timer2" define="LIN.T2_CONFIG_EN" svd="0" uielement="branch" expand="0" default="0">

          <!-- Not needed since static item list (forced to be used since lockon on that)-->
          <!-- <var define="LIN_TIMER2_CLOCK_prescaler" svd="0" header="temp_defines.h" default="1"/> -->
          <math visible="true" label="Timer2 Clock" define="LIN_TIMER2_CLOCK" header="temp_defines.h" svd="0" formula="LIN.T2_MOD.PREN?SCU_F_SYS0 / (2^(LIN.T2_MOD.T2PRE)):SCU_F_SYS0/12" unit="MHz" />

          <math visible="true" label="Max. Period" define="LIN_MAX_PERIOD" header="temp_defines.h" svd="0" formula="65535/LIN_TIMER2_CLOCK" unit="us" />


          <branch label="Timer clock setting" expand="0">

            <checkbox label="Prescaler Enabled" define="LIN.T2_MOD.PREN" uielement="branch" expand="0" default="0">

              <combo label="Prescaler" define="LIN.T2_MOD.T2PRE">
                <item label="divide by 1" override="DIV1"/>
                <item label="divide by 2" override="DIV2"/>
                <item label="divide by 4" override="DIV4"/>
                <item label="divide by 8" override="DIV8"/>
                <item label="divide by 16" override="DIV16"/>
                <item label="divide by 32" override="DIV32"/>
                <item label="divide by 64" override="DIV64"/>
                <item label="divide by 128" override="DIV128"/>
              </combo>

            </checkbox>

          </branch>

          <branch label="Mode Select" expand="0">

            <radio label="" define="LIN.T2_CON.CP_RL2">

              <radiobutton label="Auto-Reload Mode" uielement="branch">

                <combo label="Up-Down Counter Enable" define="LIN.T2_MOD.DCEN"/>

              </radiobutton>

              <radiobutton label="Capture Mode"/>

            </radio>

          </branch>

          <checkbox label="Capture/Reload/Baud-rate generator mode Enable" define="LIN.T2_CON.EXEN2" uielement="branch" default="0">

            <combo label="Edge Select in Capture Mode/Reload Mode/Baud-rate Generator Mode" define="LIN.T2_MOD.EDGESEL"/>

          </checkbox>

          <checkbox label="External Start Enable" define="LIN.T2_MOD.T2RHEN" uielement="branch">

            <combo label="Edge Select for External Start" define="LIN.T2_MOD.T2REGS"/>

          </checkbox>

          <branch label="Timer Register" expand="0">

            <radio label="" define="TIMER_REG_SEL" header="temp_defines.h" svd="0">

              <radiobutton label="...as clock ticks" uielement="branch">

                <!-- If no range had been specified, it would have taken the maximum as the "define" indicates by the dimension (e.g, in case of [15:0] would have been 2^16 - 1 = 65535) -->
                <spinbox label="Value [ticks]" define="TIMER_REG_TICKS_VALUE" header="temp_defines.h" svd="0" default="1" range="0;65535"/>

              </radiobutton>

              <radiobutton label="...as time [us]" uielement="branch">

                <!-- There is no specified limit, however a warning will be raised by the "math" formula below -->
                <doublespinbox label="Time [us]" define="TIMER_REG_TIME_VALUE" header="temp_defines.h" svd="0" default="1.00"/>

              </radiobutton>

            </radio>

            <!-- To specify a range in "math", indicate the register dimension into which the calculation will end up -->
            <!-- A warning will be raised in CW in case of register overflow -->
            <math visible="true" label="Timer Value" format="%04X" unit="ticks" define="LIN.T2_CNT[15:0]" formula="TIMER_REG_SEL?floor(0x00010000-TIMER_REG_TIME_VALUE*LIN_TIMER2_CLOCK):(0x00010000-TIMER_REG_TICKS_VALUE)"/>

          </branch>

          <branch label="Reload / Capture Register" expand="0">

            <radio label="" define="RELOAD_CAPTURE_REG_SEL" header="temp_defines.h" svd="0">

              <radiobutton label="...as clock ticks" uielement="branch">

                <spinbox label="Value [ticks]" define="RELOAD_CAPTURE_REG_TICKS_VALUE" header="temp_defines.h" svd="0" default="1" range="0;65535"/>

              </radiobutton>

              <radiobutton label="...as time [us]" uielement="branch">

                <!-- There is no specified limit, however a warning will be raised by the "math" formula below -->
                <doublespinbox label="Time [us]" define="RELOAD_CAPTURE_REG_TIME_VALUE" header="temp_defines.h" svd="0" default="1.00"/>

              </radiobutton>

            </radio>

            <!-- To specify a range in "math", indicate the register dimension into which the calculation will end up -->
            <math visible="true" label="Timer Value" define="LIN.T2_RC[15:0]" format="%04X" unit="ticks" formula="RELOAD_CAPTURE_REG_SEL?floor(0x00010000-RELOAD_CAPTURE_REG_TIME_VALUE*LIN_TIMER2_CLOCK):(0x00010000-RELOAD_CAPTURE_REG_TICKS_VALUE)" />

          </branch>

          <branch label="Interrupt" expand="1">

            <checkbox label="External" define="LIN_EXF2_INT_EN" svd="0" header="isr_defines.h" uielement="branch" expand="0" default="0">

              <checkbox label="Enable interrupt" define="LIN.LIN_IEN.EXF2EN" default="0"/>
              <edit label="Callback" define="LIN_EXF2_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

            </checkbox>

            <checkbox label="Underflow / Overflow" define="LIN_TF2_INT_EN" svd="0" header="isr_defines.h" uielement="branch" expand="0" default="0">

              <checkbox label="Enable interrupt" define="LIN.LIN_IEN.TF2EN" default="0"/>
              <edit label="Callback" define="LIN_TF2_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

            </checkbox>

          </branch>

        </checkbox>

        <checkbox label="Configure UART" define="LIN.UART_CONFIG_EN" svd="0" uielement="branch" expand="0" default="0">

          <var define="UART_CLOCK_prescaler" svd="0" header="temp_defines.h" default="1"/>
          <math visible="true" label="UART Baudrate Generator Clock (Fdiv)" header="temp_defines.h" define="LIN.UARTCLOCK" svd="0" formula="SCU_F_SYS0 / UART_CLOCK_prescaler" unit="MHz" />
          <math visible="false" label="UART Baudrate Generator Clock (Fdiv)" define="LIN.UARTCLOCK_HZ" svd="0" formula="LIN.UARTCLOCK*1000000" unit="Hz" />

          <branch label="Clock" expand="0">

            <combo label="Prescaler" define="LIN.UART_BCON.BR_PRE">
              <item label="not used" hide="NOTUSED6"/>
              <item label="not used" hide="NOTUSED7"/>
            </combo>

          </branch>

          <branch label="BaudRate generator" expand="0">

            <checkbox label="BaudRate generator running" define="LIN.UART_BCON.BR_R" default="0"/>

            <radio label="" define="BAUDRATE" header="temp_defines.h" svd="0">

              <radiobutton label="Automatic Baudrate generation" uielement="branch">

                <combo label="BaudRate" define="AUTOMATIC_BAUDRATE_VALUE" header="temp_defines.h" svd="0" default="label=19200">

                  <item label="9600" lockon="MANUAL_BAUDRATE_VALUE=9600"/>
                  <item label="19200" lockon="MANUAL_BAUDRATE_VALUE=19200"/>
                  <item label="38400" lockon="MANUAL_BAUDRATE_VALUE=38400"/>
                  <item label="57600" lockon="MANUAL_BAUDRATE_VALUE=57600"/>
                  <item label="115200" lockon="MANUAL_BAUDRATE_VALUE=115200"/>

                </combo>

              </radiobutton>

              <radiobutton label="Manual Baudrate generation" uielement="branch">

                <spinbox label="Baudrate [baud]" define="MANUAL_BAUDRATE_VALUE" header="temp_defines.h" svd="0" default="19200"/>

              </radiobutton>

            </radio>

            <math label="Baudrate Value" define="LIN.UART_BCON.BG_BR_VALUE" default="0" formula="trunc((LIN.UARTCLOCK_HZ)/(16*MANUAL_BAUDRATE_VALUE))"/>
            <!-- <spinbox label="Fractional Divider" define="LIN.UART_BCON.BG_FD_SEL" default="0" range="0;31"/> -->
            <math label="Fractional Divider" define="LIN.UART_BCON.BG_FD_SEL" formula="trunc((((LIN.UARTCLOCK_HZ)/(16*MANUAL_BAUDRATE_VALUE))-LIN.UART_BCON.BG_BR_VALUE)*32)"/>
            <math label="Effective Baudrate" define="EFFECTIVE_BAUDRATE [bit/s]" header="temp_defines.h" svd="0" formula="LIN.UARTCLOCK_HZ/(16*(LIN.UART_BCON.BG_BR_VALUE+(LIN.UART_BCON.BG_FD_SEL/32)))" />

          </branch>

          <branch label="Mode" expand="0">

            <combo label="Mode select" define="LIN.UART_SCON[1:0]" default="label=Mode 1 : 8-Bit shift UART">

              <item value="0" label="Mode 0 : 8-Bit shift register"/>
              <item value="2" label="Mode 1 : 8-Bit shift UART"/>
              <item value="1" label="Mode 2 : 9-Bit shift UART"/>
              <item value="3" label="Mode 3 : 9-Bit shift UART"/>

            </combo>

            <checkbox label="Enable Serial Port Multiprocessor Communication in Mode 2 and 3" define="LIN.UART_SCON.SM2" default="0"/>

            <checkbox label="Receiver Enabled" define="LIN.UART_SCON.REN" default="0"/>

            <!--<checkbox label="STDIN/STDOUT enabled" define="STDIN_STDOUT_ENABLED" header="temp_defines.h" svd="0" default="0"/>-->

            <checkbox label="Disable the wait for IS.RI clear to update RX buffer" define="LIN.UART_SCON.RMOD" default="0"/>

            <checkbox label="TX Data Inverter Enable" define="LIN.UART_SCON.TXINV" default="0"/>

            <combo label="Transmit Start Trigger Select" define="LIN.UART_SCON.TXENSEL"/>

            <checkbox label="STDIN/STDOUT enabled" define="LIN.UART_STD_EN" svd="0"/>

          </branch>

          <branch label="Interrupt" expand="0">

            <checkbox label="Receive" define="LIN_RX_INT_EN" svd="0" header="isr_defines.h" uielement="branch" expand="0" default="0">

              <checkbox label="Enable Interrupt" define="LIN.LIN_IEN.RIEN" default="0"/>

              <edit label="Callback" define="LIN_RX_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

            </checkbox>

            <checkbox label="Transmitter" define="LIN_TX_INT_EN" svd="0" header="isr_defines.h" uielement="branch" expand="0" default="0">

              <checkbox label="Enable Interrupt" define="LIN.LIN_IEN.TIEN" default="0"/>

              <edit label="Callback" define="LIN_TX_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

            </checkbox>

          </branch>

        </checkbox>

        <checkbox label="Configure LIN" define="LIN.LIN_CTRL.EN" uielement="branch" expand="0" default="1">

          <combo label="Transceiver Mode" define="LIN.LIN_CTRL.MODE" default="label=LIN Normal Mode"/>

          <combo label="Slope Mode" define="LIN.LIN_CTRL.SM"/>

          <checkbox label="High Voltage I/O Mode Enable" define="LIN.LIN_CTRL.HV_MODE" uielement="branch" expand="0" default="0">

            <combo label="LIN Transmitter switch on" define="LIN.LIN_CTRL.TXD"/>

          </checkbox>

          <branch label="Diagnostic Interrupt" expand="0">

            <checkbox label="Over Current" define="LIN_OC_INT_EN" svd="0" header="isr_defines.h" uielement="branch" expand="0" default="0">

              <checkbox label="Enable Interrupt" define="LIN.LIN_IEN.OC_IEN" default="0"/>

              <edit label="Callback" define="LIN_OC_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

            </checkbox>

            <checkbox label="Over Temperature" define="LIN_OT_INT_EN" svd="0" header="isr_defines.h" uielement="branch" expand="0" default="0">

              <checkbox label="Enable Interrupt" define="LIN.LIN_IEN.OT_IEN" default="0"/>

              <edit label="Callback" define="LIN_OT_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

            </checkbox>

            <checkbox label="TX Timeout" define="LIN_TMOUT_INT_EN" svd="0" header="isr_defines.h" uielement="branch" expand="0" default="0">

              <checkbox label="Enable Interrupt" define="LIN.LIN_IEN.TXD_TMOUT_IEN" default="0"/>

              <edit label="Callback" define="LIN_TMOUT_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

            </checkbox>

          </branch>

          <branch label="LIN Break/Synch Fields Detection" expand="0">

            <spinbox label="Master Baudrate [baud]" define="LIN_MASTER_BAUDRATE_VALUE" header="temp_defines.h" svd="0" default="19200"/>
            <checkbox label="Baudrate detection (Timer2)" define="LIN_BAUDARE_DETECTION_TIMER2" header="temp_defines.h" svd="0" default="0" lockon="LIN.T2_CONFIG_EN=1;LIN.T2_CON.CP_RL2=1;LIN.T2_CON.EXEN2=1;LIN.T2_MOD.EDGESEL=0;LIN.T2_MOD.T2RHEN=1;LIN.T2_MOD.T2REGS=0;LIN.T2_MOD.PREN=1;LIN.T2_MOD.T2PRE.label=divide by 1"/>

            <!--<checkbox label="Break/Sync detection enable" define="LIN.UART_LINCON.BREN" default="0"/>-->

            <math visible="false" define="LIN.UART_LINCON.BGSEL" formula="SCU_F_SYS0*1000000/LIN_MASTER_BAUDRATE_VALUE>576?3:SCU_F_SYS0*1000000/LIN_MASTER_BAUDRATE_VALUE>288?2:SCU_F_SYS0*1000000/LIN_MASTER_BAUDRATE_VALUE>144?1:0"/>

            <branch label="Interrupt" expand="0">

              <checkbox label="End-of-Synch" define="LIN_EOF_INT_EN" svd="0" header="isr_defines.h" uielement="branch" expand="0" default="0">

                <checkbox label="Enable Interrupt" define="LIN.LIN_IEN.EOFSYNEN" default="0"/>

                <edit label="Callback" define="LIN_EOF_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

              </checkbox>

              <checkbox label="Error-in-Synch" define="LIN_ERR_INT_EN" svd="0" header="isr_defines.h" uielement="branch" expand="0" default="0">

                <checkbox label="Enable Interrupt" define="LIN.LIN_IEN.ERRSYNEN" default="0"/>

                <edit label="Callback" define="LIN_ERR_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

              </checkbox>

            </branch>

          </branch>

          <branch label="Auto-Addressing" expand="0">

            <branch label="Interrupt" expand="0">

              <checkbox label="Current Measure Ready" define="LIN_AAMEASRDY_INT_EN" svd="0" header="isr_defines.h" uielement="branch" expand="0" default="0">

                <checkbox label="Enable Interrupt" define="LIN.LIN_IEN.AA_MEAS_RDY_IEN" default="0"/>

                <edit label="Callback" define="LIN_AAMEASRDY_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

              </checkbox>

              <checkbox label="Error" define="LIN_AAERR_INT_EN" svd="0" header="isr_defines.h" uielement="branch" expand="0" default="0">

                <checkbox label="Enable Interrupt" define="LIN.LIN_IEN.AA_ERR_IEN" default="0"/>

                <edit label="Callback" define="LIN_AAERR_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

              </checkbox>

            </branch>

          </branch>

          <branch label="LIN wake-up control" expand="0">

            <combo label="Filter time" define="LIN.WAKE_CNF.WU_DOM_FILT_CFG"/>
          </branch>

        </checkbox>


      </header>
    </treecontainer>

    <!-- Timers used to set the prescaler. See SCU module for better explanation -->
    <groupcontainer label="Consistency checking" visible="false">

      <!-- ENHANCEMEN FOR CW: if svd could be detached so that manual list could be inserted and using override (on each element), we would have avoided avoid timers -->
      <!-- Forced to have static list for lockon feature -->
      <!-- <timer visible="false" define="LIN_TIMER2_CLOCK_prescaler_CONSISTENCY" header="temp_defines.h" svd="0" interval="100" singleShot="0" run="1">

            <action event="changed" cond="LIN.T2_MOD.T2PRE.index==0" cmd="setDef" data="LIN_TIMER2_CLOCK_prescaler=1"/>
            <action event="changed" cond="LIN.T2_MOD.T2PRE.index==1" cmd="setDef" data="LIN_TIMER2_CLOCK_prescaler=2"/>
            <action event="changed" cond="LIN.T2_MOD.T2PRE.index==2" cmd="setDef" data="LIN_TIMER2_CLOCK_prescaler=4"/>
            <action event="changed" cond="LIN.T2_MOD.T2PRE.index==3" cmd="setDef" data="LIN_TIMER2_CLOCK_prescaler=8"/>

            <action event="changed" cond="LIN.T2_MOD.T2PRE.index==4" cmd="setDef" data="LIN_TIMER2_CLOCK_prescaler=16"/>
            <action event="changed" cond="LIN.T2_MOD.T2PRE.index==5" cmd="setDef" data="LIN_TIMER2_CLOCK_prescaler=32"/>
            <action event="changed" cond="LIN.T2_MOD.T2PRE.index==6" cmd="setDef" data="LIN_TIMER2_CLOCK_prescaler=64"/>
            <action event="changed" cond="LIN.T2_MOD.T2PRE.index==7" cmd="setDef" data="LIN_TIMER2_CLOCK_prescaler=128"/>


        </timer> -->

      <timer visible="false" define="UART_CLOCK_prescaler_CONSISTENCY" header="temp_defines.h" svd="0" interval="100" singleShot="0" run="1">

        <action event="changed" cond="LIN.UART_BCON.BR_PRE.index==0" cmd="setDef" data="UART_CLOCK_prescaler=1"/>
        <action event="changed" cond="LIN.UART_BCON.BR_PRE.index==1" cmd="setDef" data="UART_CLOCK_prescaler=2"/>
        <action event="changed" cond="LIN.UART_BCON.BR_PRE.index==2" cmd="setDef" data="UART_CLOCK_prescaler=4"/>
        <action event="changed" cond="LIN.UART_BCON.BR_PRE.index==3" cmd="setDef" data="UART_CLOCK_prescaler=8"/>

        <action event="changed" cond="LIN.UART_BCON.BR_PRE.index==4" cmd="setDef" data="UART_CLOCK_prescaler=16"/>
        <action event="changed" cond="LIN.UART_BCON.BR_PRE.index==5" cmd="setDef" data="UART_CLOCK_prescaler=32"/>
        <action event="changed" cond="LIN.UART_BCON.BR_PRE.index==6" cmd="setDef" data="UART_CLOCK_prescaler=1"/>
        <action event="changed" cond="LIN.UART_BCON.BR_PRE.index==7" cmd="setDef" data="UART_CLOCK_prescaler=1"/>


      </timer>

    </groupcontainer>

  </verticalcontainer>


</ifxmlcfg>
