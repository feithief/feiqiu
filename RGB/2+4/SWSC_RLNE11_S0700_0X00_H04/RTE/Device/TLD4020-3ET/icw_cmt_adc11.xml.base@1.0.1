<ifxmlcfg version="2.6.2">
	<checksum>b5210b7560febe6770bd1609427e7fdf80c85790a6445e192819bf2c6e23cac8</checksum>
  <version label="V1.0.1"/>


  <verticalcontainer label="ADC11" desc="Analog to Digital Converter">
    <treecontainer headerlabels="Item;Value;" label="ADC11" desc="" columnwidths="400;250">
        <header file="adc11_defines.h">
                
            <checkbox label="ADC11 enable" define="ADC11.CFG_1.ADC_ENABLE" uielement="branch" expand="0" default="0">

                <combo label="Sample time control" define="ADC11.CFG_0.ADC_STC"/>

                <combo label="Fullscale range for differential conversion (Vfwd LED)" define="ADC11.CFG_0.ADC_SEL_4V" default="label=4V fullscale selected"/>

                <combo label="Oversampling configuration" define="ADC11.CFG_0.ADC_OVERS_CFG"/>

                <checkbox label="Digital Temperature Sensor (DTS) overtemperature enable" define="ADC11.CFG_0.DTS_OVT_EN"/>

            </checkbox>

            <checkbox label="Fast comparator mode enable" define="ADC11.CFG_1.ADC_COMP_EN" uielement="branch" expand="0" default="0">
                                                                                                        <!-- 2^13 - 1 -->
                <spinbox label="Fast comparator mode digital threshold" define="ADC11.CFG_0.ADC_COMP_VAL" default="8" step="1" range="0;8191"/>

            </checkbox>

            <branch label="Interrupt Request Handling" expand="0">

                <checkbox label="Firmware End-Of-Conversion" define="ADC11_FW_EOC_INT_EN" uielement="branch" expand="0" default="0" svd="0" header="isr_defines.h">

                    <checkbox label="Enable interrupt" define="ADC11.IEN.ADC_FW_EOC"/>
                    <edit label="Callback" define="ADC11_FW_EOC_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

                </checkbox>

                <checkbox label="DTS overtemperature" define="ADC11_DTS_OVTEMP_INT_EN" uielement="branch" expand="0" default="0" svd="0" header="isr_defines.h">

                    <checkbox label="Enable interrupt" define="ADC11.IEN.DTS_OVT"/>
                    <edit label="Callback" define="ADC11_DTS_OVTEMP_CALLBACK" svd="0" header="isr_defines.h" default="place_your_function_call_back_here"/>

                </checkbox>
                
            </branch>

        </header>
    </treecontainer>

