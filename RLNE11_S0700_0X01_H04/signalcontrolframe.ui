QCheckBox::indicator { width: 30px; height: 30px; border: 2px solid #0fbacd; }
QCheckBox::indicator:checked { background: #22d39f; }
QPushButton {
  border: 2px solid #0fbacd;
  border-top-right-radius: 15px;
  border-bottom-left-radius: 15px;
  color: #fffbdc;
  background: rgba(29, 165, 219, 80);
  font-size: 22px;
  padding: 8px 18px;
}
