  color: rgb(205, 238, 247);
  font-size: 20px;
}
QScrollArea {
  border: 1px solid #0fbacd;
  background: transparent;
}
QScrollBar:vertical {
  background: #06131b;
  width: 18px;
}
QScrollBar::handle:vertical {
  background: #0fbacd;
  min-height: 35px;
  border-radius: 8px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0;
}
QSpinBox, QLineEdit {
  border: 1px solid #0fbacd;
  color: #fffbdc;
  background: rgba(0, 24, 34, 220);
  font-size: 22px;
  padding: 5px;
}
QCheckBox {
  color: #fffbdc;
  font-size: 20px;
  spacing: 12px;
}
QCheckBox::indicator {
  width: 30px;
  height: 30px;
  border: 2px solid #0fbacd;
}
QCheckBox::indicator:checked {
  background: #22d39f;
}
QPushButton {
  border: 2px solid #0fbacd;
  border-top-right-radius: 15px;
  border-bottom-left-radius: 15px;
  color: #fffbdc;
  background: rgba(29, 165, 219, 80);
  font-size: 22px;
  padding: 8px 18px;
}
QPushButton:pressed {
  background: rgba(34, 211, 159, 130);
}</string>
